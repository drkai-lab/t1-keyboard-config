#!/bin/sh
# Reload udev rules so the T1 nodes become accessible right after install.
set -e

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    for subsystem in usb hidraw input; do
        udevadm trigger --subsystem-match="$subsystem" || true
    done
fi

exit 0
