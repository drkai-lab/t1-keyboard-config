_MAC_LIBS = {}


def _mac():
    """Load IOKit / CoreFoundation and declare prototypes (macOS only)."""
    if _MAC_LIBS:
        return _MAC_LIBS
    cf = ctypes.CDLL(
        "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
    iohid = ctypes.CDLL(
        "/System/Library/Frameworks/IOKit.framework/IOKit")

    cfp, cfl, cfbl = ctypes.c_void_p, ctypes.c_long, ctypes.c_long
    cf.CFRelease.argtypes = [cfp]
    cf.CFStringCreateWithCString.restype = cfp
    cf.CFStringCreateWithCString.argtypes = [cfp, ctypes.c_char_p, cfl]
    cf.CFDictionaryCreate.restype = cfp
    cf.CFDictionaryCreate.argtypes = [
        cfp, ctypes.POINTER(cfp), ctypes.POINTER(cfp), cfl, cfp, cfp]
    cf.CFSetGetValues.argtypes = [cfp, ctypes.POINTER(cfp)]
    cf.CFSetGetCount.argtypes = [cfp]
    cf.CFSetGetCount.restype = cfl
    iohid.IOHIDManagerCreate.restype = cfp
    iohid.IOHIDManagerCreate.argtypes = [cfp, cfl]
    iohid.IOHIDManagerSetDeviceMatching.argtypes = [cfp, cfp]
    iohid.IOHIDManagerOpen.argtypes = [cfp, cfl]
    iohid.IOHIDManagerCopyDevices.restype = cfp
    iohid.IOHIDManagerCopyDevices.argtypes = [cfp]
    iohid.IOHIDDeviceOpen.argtypes = [cfp, cfl]
    iohid.IOHIDDeviceSetReport.argtypes = [
        cfp, cfl, cfl, ctypes.c_void_p, cfl]
    iohid.IOHIDDeviceSetReport.restype = cfl
    iohid.IOHIDDeviceCopyMatchingElements.restype = cfp
    iohid.IOHIDDeviceCopyMatchingElements.argtypes = [cfp, cfp, cfl]
    iohid.IOHIDElementGetReportID.argtypes = [cfp]
    iohid.IOHIDElementGetReportID.restype = cfl
    iohid.IOHIDElementGetType.argtypes = [cfp]
    iohid.IOHIDElementGetType.restype = cfl
    iohid.IOHIDElementGetReportSize.argtypes = [cfp]
    iohid.IOHIDElementGetReportSize.restype = cfl

    _MAC_LIBS.update({"cf": cf, "iohid": iohid})
    return _MAC_LIBS


def _cf_string(text):
    libs = _mac()
    return libs["cf"].CFStringCreateWithCString(
        None, text.encode("utf-8"), 0x08000100)


def _cf_dict(pairs):
    """Small CFDictionary with CFType callbacks (resolved from the library)."""
    libs = _mac()
    cf = libs["cf"]
    keys = (ctypes.c_void_p * len(pairs))()
    values = (ctypes.c_void_p * len(pairs))()
    for index, (key, value) in enumerate(pairs):
        keys[index] = _cf_string(key)
        values[index] = _cf_string(value)
    key_cb = ctypes.c_void_p.in_dll(cf, "kCFTypeDictionaryKeyCallBacks")
    val_cb = ctypes.c_void_p.in_dll(cf, "kCFTypeDictionaryValueCallBacks")
    return cf.CFDictionaryCreate(
        None, keys, values, len(pairs),
        ctypes.addressof(key_cb), ctypes.addressof(val_cb))


def _cf_release(ref):
    if ref:
        try:
            _mac()["cf"].CFRelease(ref)
        except Exception:
            pass


def mac_find_device():
    """(device_ref, report_id) for the T1 config interface, or (None, None)."""
    libs = _mac()
    iohid = libs["iohid"]
    manager = iohid.IOHIDManagerCreate(None, 0)
    if not manager:
        return None, None
    match = _cf_dict([("VendorID", "%d" % VID), ("ProductID", "%d" % PID)])
    try:
        iohid.IOHIDManagerSetDeviceMatching(manager, match)
        iohid.IOHIDManagerOpen(manager, 0)
        devices = iohid.IOHIDManagerCopyDevices(manager)
        if not devices:
            return None, None
        count = int(libs["cf"].CFSetGetCount(devices))
        values = (ctypes.c_void_p * max(1, count))()
        libs["cf"].CFSetGetValues(devices, ctypes.byref(values))
        best, best_id = None, 0
        for index in range(count):
            device = values[index]
            if not device:
                continue
            report_id, has_input = _mac_device_info(device)
            if not has_input:
                best, best_id = device, report_id
                break
            if best is None:
                best, best_id = device, report_id
        return best, best_id
    finally:
        _cf_release(match)
        _cf_release(manager)


def _mac_device_info(device):
    """(report_id, has_input) for one IOHIDDevice."""
    libs = _mac()
    iohid = libs["iohid"]
    elements = iohid.IOHIDDeviceCopyMatchingElements(device, None, 0)
    report_id, has_input = 0, False
    if elements:
        count = int(libs["cf"].CFSetGetCount(elements))
        values = (ctypes.c_void_p * max(1, count))()
        libs["cf"].CFSetGetValues(elements, ctypes.byref(values))
        for index in range(min(count, 256)):
            element = values[index]
            if not element:
                continue
            etype = int(iohid.IOHIDElementGetType(element))
            if etype in (1, 2, 3, 4, 128):  # input misc / button / axis
                has_input = True
            if etype in (129, 130, 131):  # output / feature
                report_id = int(iohid.IOHIDElementGetReportID(element)) or report_id
        _cf_release(elements)
    return report_id, has_input


class MacHidTransport(BaseTransport):
    """IOHIDDeviceSetReport writer for the T1 config interface (macOS)."""

    kind = "hid"

    def __init__(self):
        self._device = None
        self._report_id = 3
        self.last_error = None
        self.node = "IOHIDDevice"

    def is_open(self):
        return self._device is not None

    def close(self):
        if self._device is not None:
            try:
                _mac()["iohid"].IOHIDDeviceClose(self._device, 0)
            except Exception:
                pass
            _cf_release(self._device)
        self._device = None

    def open(self):
        self.close()
        try:
            device, report_id = mac_find_device()
        except Exception as exc:
            self.last_error = "enum-failed: %s" % exc
            return None
        if not device:
            self.last_error = "device-not-found"
            return None
        error = _mac()["iohid"].IOHIDDeviceOpen(device, 0)
        if error:
            self.last_error = "open-failed: error %d" % error
            _cf_release(device)
            return None
        self._device = device
        self._report_id = report_id or 3
        return self._report_id, 64, True

    def send_frame(self, frame, report_id=0, has_report_id=True):
        if self._device is None:
            return False
        data = bytes(frame)
        if has_report_id:
            if not data:
                return False
            report_id, data = data[0], data[1:]
        try:
            buf = ctypes.create_string_buffer(data, len(data))
            error = _mac()["iohid"].IOHIDDeviceSetReport(
                self._device, 1, report_id, buf, len(data))
        except Exception:
            return False
        return error == 0


def make_transport():
    if IS_WIN:
        return WindowsHidTransport()
    if IS_MAC:
        return MacHidTransport()
    return LinuxUsbfsTransport()
class T1Device:
    """Protocol layer: framing, probing and the write commands.

    The platform specific send path lives in a transport (usbfs / HID);
    this class only deals with report ids, frames and command sequences.
    """

    DEFAULT_DATA_LEN = 64

    def __init__(self):
        self.report_id = 3
        self.data_len = self.DEFAULT_DATA_LEN
        self.had_report_id = True
        self._fail_count = 0
        self._transport = make_transport()

    # -- transport proxies --------------------------------------------------
    @property
    def last_error(self):
        return self._transport.last_error

    @last_error.setter
    def last_error(self, value):
        self._transport.last_error = value

    @property
    def node(self):
        return self._transport.node

    @property
    def transport_kind(self):
        return self._transport.kind

    @property
    def _urb_type(self):
        return getattr(self._transport, "_urb_type", None)

    def is_open(self):
        return self._transport.is_open()

    def close(self):
        self._transport.close()

    def connect(self):
        self.close()
        found = self._transport.open()
        if found is None:
            return False
        rid, data_len, had_id = found
        if rid is not None:
            self.report_id, self.data_len, self.had_report_id = rid, data_len, had_id
        else:
            self.report_id, self.had_report_id = 3, True
            self.data_len = self.DEFAULT_DATA_LEN
        if not self.had_report_id:
            self.report_id = 0
        if not self.probe():
            self.close()
            self.last_error = "probe-failed"
            return False
        return True

    # -- framing ------------------------------------------------------------
    def frame(self, payload):
        if self.had_report_id:
            total = 1 + self.data_len
            buf = bytearray(total)
            buf[0] = self.report_id & 0xFF
            body = bytes(payload)[:self.data_len]
            buf[1:1 + len(body)] = body
        else:
            buf = bytearray(self.data_len)
            body = bytes(payload)[:self.data_len]
            buf[:len(body)] = body
        return bytes(buf)

    def write_payload(self, payload):
        if not self.is_open():
            return False
        ok = self._transport.send_frame(
            self.frame(payload), self.report_id, self.had_report_id)
        if ok:
            self._fail_count = 0
            return True
        self._fail_count += 1
        if self._fail_count >= 3:
            self.close()
            self.last_error = "write-failed"
        return False

    def probe(self):
        if not self.had_report_id:
            candidates = [0]
        else:
            first = self.report_id
            candidates = [first] + [r for r in (3, 0, 2) if r != first]
        for rid in candidates:
            self.report_id = rid
            self._fail_count = 0
            if self.write_payload(probe_report()):
                return True
            if not self.is_open():
                return False
        return False

    def write_many(self, payloads):
        for payload in payloads:
            if not self.write_payload(payload):
                return False
        return True

    def switch_layer(self, layer):
        return self.write_payload(layer_report(layer))

    def write_key(self, keynum, layer, keys, lone_mod=0):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_many(key_reports(keynum, layer, self.report_id, keys, lone_mod)):
            return False
        return self.write_payload(flash_report())

    def write_media(self, keynum, layer, action):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_payload(media_report(keynum, layer, self.report_id, action)):
            return False
        return self.write_payload(flash_report())

    def write_mouse(self, keynum, layer, action):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_payload(mouse_report(keynum, layer, self.report_id, action)):
            return False
        return self.write_payload(flash_report())

    def write_led(self, layer, mode):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_payload(led_report(layer, self.report_id, mode)):
            return False
        return self.write_payload(flash_led_report())


def parse_report_descriptor(data):
    """Minimal HID report descriptor parser -> {"outputs": {rid: bits}}."""
    outputs = {}
    rid, rsize, rcount = 0, 0, 0
    pos, size = 0, len(data)
    while pos < size:
        prefix = data[pos]
        pos += 1
        if prefix == 0xFE:
            if pos + 2 > size:
                break
            long_size = data[pos]
            pos += 3 + long_size
            continue
        item_size = prefix & 0x03
        if item_size == 3:
            item_size = 4
        if pos + item_size > size:
            break
        value = int.from_bytes(data[pos:pos + item_size], "little")
        pos += item_size
        btype = (prefix >> 2) & 0x03
        tag = prefix >> 4
        if btype == 1:
            if tag == 8:
                rid = value
            elif tag == 7:
                rsize = value
            elif tag == 9:
                rcount = value
        elif btype == 0:
            if tag == 9:
                outputs[rid] = outputs.get(rid, 0) + rsize * rcount
    if not outputs:
        return None
    return {"outputs": outputs}


def hid_descriptor_lengths(config_data):
    """{interface_number: wDescriptorLength} for HID (0x21) descriptors.

    Walks the configuration descriptor so each HID descriptor is matched with
    the interface that precedes it.
    """
    lengths = {}
    interface = -1
    pos, size = 0, len(config_data)
    while pos + 2 <= size:
        length = config_data[pos]
        dtype = config_data[pos + 1]
        if length < 2 or pos + length > size:
            break
        if dtype == 0x04 and length >= 4:
            interface = config_data[pos + 2]
        elif dtype == 0x21 and length >= 9 and interface not in lengths:
            report_len = int.from_bytes(config_data[pos + 7:pos + 9], "little")
            if 16 <= report_len <= 1024:
                lengths[interface] = report_len
        pos += length
    return lengths


