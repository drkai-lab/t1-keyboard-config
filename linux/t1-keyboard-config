        def on_add_group(self, _btn):
            mods = 0
            for mask, check in self.mod_checks.items():
                if check.get_active():
                    mods |= mask
            index = self.base_dd.get_selected()
            if index == 0:
                self.groups = []
            elif len(self.groups) < 5:
                self.groups.append((mods, USAGE_KEYS[index - 1][1]))
            self.render_groups()

        def on_reset_groups(self, _btn):
            self.groups = []
            self.group_mod = 0
            for check in self.mod_checks.values():
                check.set_active(False)
            self.base_dd.set_selected(0)
            self.render_groups()

        def render_groups(self):
            while True:
                child = self.groups_list.get_first_child()
                if child is None:
                    break
                self.groups_list.remove(child)
            if not self.groups:
                row = Gtk.ListBoxRow()
                row.set_child(Gtk.Label(label=self.tr("assign_empty"), xalign=0))
                self.groups_list.append(row)
                return
            for mods, usage in self.groups:
                row = Gtk.ListBoxRow()
                row.set_child(Gtk.Label(label=self.describe(mods, usage), xalign=0))
                self.groups_list.append(row)

        @staticmethod
        def describe(mods, usage):
            names = [name for name, mask in MODIFIERS if mods & mask]
            if usage:
                for label, code in USAGE_KEYS:
                    if code == usage:
                        names.append(label)
                        break
            return "+".join(names) or "-"

        def build_pending_from_groups(self):
            mods = 0
            for mask, check in self.mod_checks.items():
                if check.get_active():
                    mods |= mask
            index = self.base_dd.get_selected()
            if index == 0:
                keys = []
                lone = mods
                desc = self.describe(mods, 0)
            else:
                keys = list(self.groups)
                if not keys:
                    keys = [(mods, USAGE_KEYS[index - 1][1])]
                lone = keys[0][0]
                desc = " / ".join(self.describe(gmod, gusage) for gmod, gusage in keys)
            return {"kind": "key", "desc": desc, "keys": keys, "lone_mod": lone}

        def on_download(self, _btn):
            page = self.notebook.get_current_page()
            if page == 0:
                row = self.basic_list.get_selected_row()
                if row is None:
                    self.status(self.tr("pick_function"))
                    return
                self.pending = {"kind": "key", "desc": row.get_child().get_text(),
                                "keys": [(0, row.usage)], "lone_mod": 0}
            elif page == 1:
                self.pending = self.build_pending_from_groups()
            elif page == 2:
                row = self.notebook.get_nth_page(2).get_selected_row()
                if row is None:
                    self.status(self.tr("pick_function"))
                    return
                self.pending = {"kind": "media", "action": row.action, "desc": row.desc}
            elif page == 3:
                row = self.notebook.get_nth_page(3).get_selected_row()
                if row is None:
                    self.status(self.tr("pick_function"))
                    return
                self.pending = {"kind": "mouse", "action": row.action, "desc": row.desc}
            elif page == 4:
                row = self.led_list.get_selected_row()
                if row is None:
                    self.status(self.tr("pick_function"))
                    return
                self.pending = {"kind": "led", "mode": row.mode, "desc": row.desc}
            if self.pending is None:
                self.status(self.tr("pick_function"))
                return
            self.write_pending()

        def write_pending(self):
            pending = self.pending
            if pending is None:
                self.status(self.tr("pick_function"))
                return
            if pending["kind"] == "led":
                if not self.dev.is_open():
                    self.status(self.tr("need_device"))
                    return
                ok = self.dev.write_led(self.current_layer(), pending["mode"])
            else:
                if not self.require_key():
                    return
                layer = self.current_layer()
                if pending["kind"] == "key":
                    ok = self.dev.write_key(self.selected_key, layer,
                                            pending["keys"], pending.get("lone_mod", 0))
                elif pending["kind"] == "media":
                    ok = self.dev.write_media(self.selected_key, layer, pending["action"])
                else:
                    ok = self.dev.write_mouse(self.selected_key, layer, pending["action"])
            if ok:
                self.remember(pending["desc"])
                self.status("%s (%s)" % (self.tr("download_ok"), pending["desc"]))
            else:
                self.status(self.tr("download_ng"))

