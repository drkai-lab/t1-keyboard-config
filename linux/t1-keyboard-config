VERSION = "1.0.0"
APP_NAME = "t1-keyboard-config"
VID, PID = 0x1189, 0x8890
CONFIG_DIR = os.path.expanduser("~/.config/t1-keyboard")
CONFIG_FILE = os.path.join(CONFIG_DIR, "settings.json")
STATE_DIR = os.path.expanduser("~/.local/state/t1-keyboard")
LOG_FILE = os.path.join(STATE_DIR, "monitor.log")
UDEV_RULE = "/etc/udev/rules.d/99-t1-keyboard.rules"
CONFIG_INTERFACE = 1
CONFIG_ENDPOINT = 0x02

TYPE_KEY, TYPE_MEDIA, TYPE_MOUSE, TYPE_LED = 1, 2, 3, 8


def load_settings():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
            return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def save_settings(settings):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(settings, fh, indent=2, ensure_ascii=False)
    os.replace(tmp, CONFIG_FILE)


# ---------------------------------------------------------------------------
# Protocol encoders (pure functions, covered by tests/test_protocol.py)
# ---------------------------------------------------------------------------

def type_byte(layer, rtype, report_id):
    if report_id == 0:
        return rtype & 0x0F
    return ((layer & 0x0F) << 4) | (rtype & 0x0F)


def key_reports(keynum, layer, report_id, keys, lone_mod=0):
    """Build the group reports for a key assignment.

    keys: [(modifier_mask, usage), ...] in firmware slot order.
    Group 0 is the modifier-only prologue, groups 1..n carry the usages.
    """
    keys = list(keys)[:5]
    count = len(keys)
    first_mod = keys[0][0] if keys else (lone_mod & 0xFF)
    tb = type_byte(layer, TYPE_KEY, report_id)
    out = []
    for idx in range(count + 1):
        mod, usage = (first_mod, 0) if idx == 0 else keys[idx - 1]
        out.append(bytes([keynum & 0xFF, tb, count, idx, mod & 0xFF, usage & 0xFF]))
    return out


MEDIA_RID = {
    3: {"play": (205, 0), "prev": (182, 0), "next": (181, 0),
        "mute": (226, 0), "vol_up": (233, 0), "vol_down": (234, 0)},
    0: {"play": (64, 0), "prev": (128, 0), "next": (0, 1),
        "mute": (4, 0), "vol_up": (2, 0), "vol_down": (1, 0)},
    2: {"play": (0, 4), "prev": (0, 11), "next": (0, 10),
        "mute": (0, 1), "vol_up": (64, 0), "vol_down": (128, 0)},
}

MOUSE_PAYLOAD = {
    "left":  (1, 0, 0, 0, 0),
    "right": (2, 0, 0, 0, 0),
    "centre": (4, 0, 0, 0, 0),
    "wheel_up": (0, 0, 0, 1, 0),
    "wheel_down": (0, 0, 0, 0xFF, 0),
    "ctrl_wheel_up": (0, 0, 1, 1, 0),
    "ctrl_wheel_down": (0, 0, 1, 0xFF, 0),
    "shift_wheel_up": (0, 0, 1, 2, 0),
    "shift_wheel_down": (0, 0, 1, 0xFF, 0),
    "alt_wheel_up": (0, 0, 1, 4, 0),
    "alt_wheel_down": (0, 0, 1, 0xFF, 0),
}


def media_report(keynum, layer, report_id, action):
    table = MEDIA_RID.get(report_id, MEDIA_RID[3])
    b5, b6 = table[action]
    return bytes([keynum & 0xFF, type_byte(layer, TYPE_MEDIA, report_id), b5, b6])


def mouse_report(keynum, layer, report_id, action):
    payload = MOUSE_PAYLOAD[action]
    return bytes([keynum & 0xFF, type_byte(layer, TYPE_MOUSE, report_id)]) + bytes(payload)


def led_report(layer, report_id, mode):
    return bytes([0xB0, type_byte(layer, TYPE_LED, report_id), mode & 0x03])


def layer_report(layer):
    return bytes([0xA1, max(1, min(3, int(layer)))])


def flash_report():
    return bytes([0xAA, 0xAA])


def flash_led_report():
    return bytes([0xAA, 0xA1])


def probe_report():
    return bytes([0x00, 0x00])


# ---------------------------------------------------------------------------
# usbfs transport
# ---------------------------------------------------------------------------

def _IOC(dir_, type_, nr, size):
    return (dir_ << 30) | (ord(type_) << 8) | nr | (size << 16)


USBDEVFS_CONTROL = _IOC(3, "U", 0, 24)
USBDEVFS_SUBMITURB = _IOC(2, "U", 10, 56)
USBDEVFS_DISCARDURB = _IOC(0, "U", 11, 0)
USBDEVFS_REAPURB = _IOC(1, "U", 12, 8)
USBDEVFS_REAPURBNDELAY = _IOC(1, "U", 13, 8)
USBDEVFS_CLAIMINTERFACE = _IOC(2, "U", 15, 4)
USBDEVFS_RELEASEINTERFACE = _IOC(2, "U", 16, 4)
USBDEVFS_URB_TYPE_INTERRUPT = 1
USBDEVFS_URB_TYPE_BULK = 3

URB_TYPE_ORDER = (USBDEVFS_URB_TYPE_INTERRUPT, USBDEVFS_URB_TYPE_BULK)


class _Urb(ctypes.Structure):
    _fields_ = [
        ("type", ctypes.c_ubyte),
        ("endpoint", ctypes.c_ubyte),
        ("status", ctypes.c_int),
        ("flags", ctypes.c_uint),
        ("buffer", ctypes.c_void_p),
        ("buffer_length", ctypes.c_int),
        ("actual_length", ctypes.c_int),
        ("start_frame", ctypes.c_int),
        ("stream_id", ctypes.c_uint),
        ("error_count", ctypes.c_int),
        ("signr", ctypes.c_uint),
        ("usercontext", ctypes.c_void_p),
    ]


class _Ctrl(ctypes.Structure):
    _fields_ = [
        ("bRequestType", ctypes.c_ubyte),
        ("bRequest", ctypes.c_ubyte),
        ("wValue", ctypes.c_ushort),
        ("wIndex", ctypes.c_ushort),
        ("wLength", ctypes.c_ushort),
        ("timeout", ctypes.c_uint),
        ("data", ctypes.c_void_p),
    ]


def find_usb_node():
    for entry in glob.glob("/sys/bus/usb/devices/*"):
        if ":" in entry:
            continue
        try:
            vid = int(open(os.path.join(entry, "idVendor")).read().strip(), 16)
            pid = int(open(os.path.join(entry, "idProduct")).read().strip(), 16)
        except OSError:
            continue
        if vid == VID and pid == PID:
            try:
                bus = int(open(os.path.join(entry, "busnum")).read())
                dev = int(open(os.path.join(entry, "devnum")).read())
                return bus, dev, entry
            except OSError:
                return None
    return None


def usb_node_path():
    found = find_usb_node()
    if not found:
        return None
    bus, dev, _ = found
    return "/dev/bus/usb/%03d/%03d" % (bus, dev)


class DeviceError(RuntimeError):
    pass


class T1Device:
    """Writer for the T1 config interface (usbfs interrupt-OUT / control)."""

    DEFAULT_DATA_LEN = 64

    def __init__(self):
        self.fd = None
        self.report_id = 3
        self.data_len = self.DEFAULT_DATA_LEN
        self.had_report_id = True
        self.node = None
        self.last_error = None
        self._urb_type = None
        self._fail_count = 0

    def is_open(self):
        return self.fd is not None

    def close(self):
        if self.fd is not None:
            try:
                fcntl.ioctl(self.fd, USBDEVFS_RELEASEINTERFACE,
                            ctypes.c_uint(CONFIG_INTERFACE))
            except OSError:
                pass
            try:
                os.close(self.fd)
            except OSError:
                pass
        self.fd = None
        self.node = None

    def connect(self):
        self.close()
        found = find_usb_node()
        if not found:
            self.last_error = "device-not-found"
            return False
        bus, dev, _ = found
        path = "/dev/bus/usb/%03d/%03d" % (bus, dev)
        try:
            self.fd = os.open(path, os.O_RDWR)
        except PermissionError:
            self.last_error = "permission"
            raise DeviceError(
                "Permission denied on %s\n"
                "Install the udev rule first:\n"
                "  sudo ./install.sh\n"
                "  (or: sudo cp 99-t1-keyboard.rules /etc/udev/rules.d/ "
                "&& sudo udevadm control --reload-rules && sudo udevadm trigger "
                "&& unplug/replug the keyboard)" % path)
        except OSError as exc:
            self.last_error = str(exc)
            return False
        self.node = path
        try:
            fcntl.ioctl(self.fd, USBDEVFS_CLAIMINTERFACE, ctypes.c_uint(CONFIG_INTERFACE))
        except OSError as exc:
            self.close()
            if exc.errno == errno.EBUSY:
                self.last_error = ("claim-failed: device busy - another "
                                   "t1-keyboard-config window/monitor is using it")
            else:
                self.last_error = "claim-failed: %s" % exc
            return False

        try:
            rid, data_len, had_id = self.read_report_descriptor()
        except Exception:
            rid, data_len, had_id = None, None, None
        if rid is not None:
            self.report_id, self.data_len, self.had_report_id = rid, data_len, had_id
        else:
            self.report_id, self.had_report_id = 3, True
            self.data_len = self.DEFAULT_DATA_LEN
        if not self.had_report_id:
            self.report_id = 0
        if not self.probe():
            self.close()
            self.last_error = "probe-failed"
            return False
        return True

    # -- descriptor ---------------------------------------------------------
    def control_in(self, request_type, request, wvalue, windex, length, timeout=1000):
        buf = ctypes.create_string_buffer(length)
        ctrl = _Ctrl(request_type, request, wvalue, windex, length, timeout,
                     ctypes.cast(buf, ctypes.c_void_p))
        n = fcntl.ioctl(self.fd, USBDEVFS_CONTROL, ctrl)
        if n < 0:
            raise OSError("control transfer failed")
        return buf.raw[:n]

    def hid_descriptor_lengths(self):
        """{interface: wDescriptorLength} from the configuration descriptor.

        The length must come from the HID descriptor: asking for a larger
        wLength makes the T1 firmware stall the endpoint and the xHCI
        controller eventually reports "HC died" (observed with wLength=1024).
        """
        try:
            head = self.control_in(0x81, 0x06, 0x0200, 0, 9, timeout=500)
            if len(head) < 4:
                return {}
            total = int.from_bytes(head[2:4], "little")
            if total < 9:
                return {}
            total = min(total, 1024)
            data = head if total == 9 else self.control_in(
                0x81, 0x06, 0x0200, 0, total, timeout=500)
        except OSError:
            return {}
        return hid_descriptor_lengths(data)

    def read_report_descriptor(self):
        lengths = self.hid_descriptor_lengths()
        length = lengths.get(CONFIG_INTERFACE)
        if not length and lengths:
            length = next(iter(lengths.values()))
        if not length:
            return None, None, None
        try:
            data = self.control_in(0x81, 0x06, 0x2200, CONFIG_INTERFACE, length,
                                   timeout=500)
        except OSError:
            return None, None, None
        parsed = parse_report_descriptor(data)
        if not parsed:
            return None, None, None
        outputs = parsed["outputs"]
        if not outputs:
            return None, None, None
        if len(outputs) == 1:
            rid, bits = next(iter(outputs.items()))
        else:
            non_zero = [r for r in outputs if r != 0]
            rid = non_zero[0] if non_zero else 0
            bits = outputs[rid]
        data_bytes = max(1, (bits + 7) // 8)
        return rid, data_bytes, rid != 0

    # -- framing ------------------------------------------------------------
    def frame(self, payload):
        if self.had_report_id:
            total = 1 + self.data_len
            buf = bytearray(total)
            buf[0] = self.report_id & 0xFF
            body = bytes(payload)[:self.data_len]
            buf[1:1 + len(body)] = body
        else:
            buf = bytearray(self.data_len)
            body = bytes(payload)[:self.data_len]
            buf[:len(body)] = body
        return bytes(buf)

    def _send_frame(self, frame):
        for urb_type in self._urb_order():
            if self._send_urb(frame, urb_type):
                self._urb_type = urb_type
                return True
        return self._send_control(frame)

    def _urb_order(self):
        if self._urb_type in URB_TYPE_ORDER:
            return (self._urb_type,)
        return URB_TYPE_ORDER

    def _send_urb(self, frame, urb_type):
        keepalive = (ctypes.c_ubyte * len(frame)).from_buffer_copy(frame)
        urb = _Urb()
        urb.type = urb_type
        urb.endpoint = CONFIG_ENDPOINT
        urb.buffer = ctypes.addressof(keepalive)
        urb.buffer_length = len(frame)
        try:
            fcntl.ioctl(self.fd, USBDEVFS_SUBMITURB, urb)
        except OSError:
            return False
        deadline = time.time() + 2.0
        slot = ctypes.c_void_p(0)
        while time.time() < deadline:
            try:
                fcntl.ioctl(self.fd, USBDEVFS_REAPURBNDELAY, slot)
                return urb.status == 0
            except BlockingIOError:
                time.sleep(0.01)
            except OSError:
                break
        try:
            fcntl.ioctl(self.fd, USBDEVFS_DISCARDURB, 0)
        except OSError:
            pass
        return False

    def _send_control(self, frame):
        try:
            wvalue = (0x02 << 8) | (self.report_id if self.had_report_id else 0)
            buf = ctypes.create_string_buffer(bytes(frame), len(frame))
            ctrl = _Ctrl(0x21, 0x09, wvalue, CONFIG_INTERFACE, len(frame), 1000,
                         ctypes.cast(buf, ctypes.c_void_p))
            return fcntl.ioctl(self.fd, USBDEVFS_CONTROL, ctrl) >= 0
        except OSError:
            return False

    def write_payload(self, payload):
        if self.fd is None:
            return False
        ok = self._send_frame(self.frame(payload))
        if ok:
            self._fail_count = 0
            return True
        self._fail_count += 1
        if self._fail_count >= 3:
            self.close()
            self.last_error = "write-failed"
        return False

    def probe(self):
        if not self.had_report_id:
            candidates = [0]
        else:
            first = self.report_id
            candidates = [first] + [r for r in (3, 0, 2) if r != first]
        for rid in candidates:
            self.report_id = rid
            self._fail_count = 0
            if self.write_payload(probe_report()):
                return True
            if self.fd is None:
                return False
        return False

    def write_many(self, payloads):
        for payload in payloads:
            if not self.write_payload(payload):
                return False
        return True

    def switch_layer(self, layer):
        return self.write_payload(layer_report(layer))

    def write_key(self, keynum, layer, keys, lone_mod=0):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_many(key_reports(keynum, layer, self.report_id, keys, lone_mod)):
            return False
        return self.write_payload(flash_report())

    def write_media(self, keynum, layer, action):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_payload(media_report(keynum, layer, self.report_id, action)):
            return False
        return self.write_payload(flash_report())

    def write_mouse(self, keynum, layer, action):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_payload(mouse_report(keynum, layer, self.report_id, action)):
            return False
        return self.write_payload(flash_report())

    def write_led(self, layer, mode):
        if self.report_id != 0 and not self.switch_layer(layer):
            return False
        if not self.write_payload(led_report(layer, self.report_id, mode)):
            return False
        return self.write_payload(flash_led_report())


def parse_report_descriptor(data):
    """Minimal HID report descriptor parser -> {"outputs": {rid: bits}}."""
    outputs = {}
    rid, rsize, rcount = 0, 0, 0
    pos, size = 0, len(data)
    while pos < size:
        prefix = data[pos]
        pos += 1
        if prefix == 0xFE:
            if pos + 2 > size:
                break
            long_size = data[pos]
            pos += 3 + long_size
            continue
        item_size = prefix & 0x03
        if item_size == 3:
            item_size = 4
        if pos + item_size > size:
            break
        value = int.from_bytes(data[pos:pos + item_size], "little")
        pos += item_size
        btype = (prefix >> 2) & 0x03
        tag = prefix >> 4
        if btype == 1:
            if tag == 8:
                rid = value
            elif tag == 7:
                rsize = value
            elif tag == 9:
                rcount = value
        elif btype == 0:
            if tag == 9:
                outputs[rid] = outputs.get(rid, 0) + rsize * rcount
    if not outputs:
        return None
    return {"outputs": outputs}


def hid_descriptor_lengths(config_data):
    """{interface_number: wDescriptorLength} for HID (0x21) descriptors.

    Walks the configuration descriptor so each HID descriptor is matched with
    the interface that precedes it.
    """
    lengths = {}
    interface = -1
    pos, size = 0, len(config_data)
    while pos + 2 <= size:
        length = config_data[pos]
        dtype = config_data[pos + 1]
        if length < 2 or pos + length > size:
            break
        if dtype == 0x04 and length >= 4:
            interface = config_data[pos + 2]
        elif dtype == 0x21 and length >= 9 and interface not in lengths:
            report_len = int.from_bytes(config_data[pos + 7:pos + 9], "little")
            if 16 <= report_len <= 1024:
                lengths[interface] = report_len
        pos += length
    return lengths


