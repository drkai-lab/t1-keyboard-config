class DeviceError(RuntimeError):
    pass


class BaseTransport:
    """Sends framed reports to the T1 config interface.

    open() claims the interface and returns
    (report_id, data_len, had_report_id); report_id may be None when the
    descriptor could not be read. It returns None on hard failures and sets
    last_error, or raises DeviceError when the caller must fix permissions.
    """

    kind = "none"
    last_error = None
    node = None

    def open(self):
        raise NotImplementedError

    def close(self):
        pass

    def is_open(self):
        return False

    def send_frame(self, frame, report_id=0, has_report_id=True):
        raise NotImplementedError


def _IOC(dir_, type_, nr, size):
    return (dir_ << 30) | (ord(type_) << 8) | nr | (size << 16)


USBDEVFS_CONTROL = _IOC(3, "U", 0, 24)
USBDEVFS_SUBMITURB = _IOC(2, "U", 10, 56)
USBDEVFS_DISCARDURB = _IOC(0, "U", 11, 0)
USBDEVFS_REAPURB = _IOC(1, "U", 12, 8)
USBDEVFS_REAPURBNDELAY = _IOC(1, "U", 13, 8)
USBDEVFS_CLAIMINTERFACE = _IOC(2, "U", 15, 4)
USBDEVFS_RELEASEINTERFACE = _IOC(2, "U", 16, 4)
USBDEVFS_URB_TYPE_INTERRUPT = 1
USBDEVFS_URB_TYPE_BULK = 3

URB_TYPE_ORDER = (USBDEVFS_URB_TYPE_INTERRUPT, USBDEVFS_URB_TYPE_BULK)

class _Urb(ctypes.Structure):
    _fields_ = [
        ("type", ctypes.c_ubyte),
        ("endpoint", ctypes.c_ubyte),
        ("status", ctypes.c_int),
        ("flags", ctypes.c_uint),
        ("buffer", ctypes.c_void_p),
        ("buffer_length", ctypes.c_int),
        ("actual_length", ctypes.c_int),
        ("start_frame", ctypes.c_int),
        ("stream_id", ctypes.c_uint),
        ("error_count", ctypes.c_int),
        ("signr", ctypes.c_uint),
        ("usercontext", ctypes.c_void_p),
    ]


class _Ctrl(ctypes.Structure):
    _fields_ = [
        ("bRequestType", ctypes.c_ubyte),
        ("bRequest", ctypes.c_ubyte),
        ("wValue", ctypes.c_ushort),
        ("wIndex", ctypes.c_ushort),
        ("wLength", ctypes.c_ushort),
        ("timeout", ctypes.c_uint),
        ("data", ctypes.c_void_p),
    ]


def find_usb_node():
    for entry in glob.glob("/sys/bus/usb/devices/*"):
        if ":" in entry:
            continue
        try:
            vid = int(open(os.path.join(entry, "idVendor")).read().strip(), 16)
            pid = int(open(os.path.join(entry, "idProduct")).read().strip(), 16)
        except OSError:
            continue
        if vid == VID and pid == PID:
            try:
                bus = int(open(os.path.join(entry, "busnum")).read())
                dev = int(open(os.path.join(entry, "devnum")).read())
                return bus, dev, entry
            except OSError:
                return None
    return None


def usb_node_path():
    found = find_usb_node()
    if not found:
        return None
    bus, dev, _ = found
    return "/dev/bus/usb/%03d/%03d" % (bus, dev)


class LinuxUsbfsTransport(BaseTransport):
    """usbfs (SUBMITURB) writer for the T1 config interface."""

    kind = "usbfs"

    def __init__(self):
        self.fd = None
        self._urb_type = None
        self.last_error = None
        self.node = None

    def is_open(self):
        return self.fd is not None

    def close(self):
        if self.fd is not None:
            try:
                fcntl.ioctl(self.fd, USBDEVFS_RELEASEINTERFACE,
                            ctypes.c_uint(CONFIG_INTERFACE))
            except OSError:
                pass
            try:
                os.close(self.fd)
            except OSError:
                pass
        self.fd = None
        self.node = None

    def open(self):
        self.close()
        found = find_usb_node()
        if not found:
            self.last_error = "device-not-found"
            return None
        bus, dev, _ = found
        path = "/dev/bus/usb/%03d/%03d" % (bus, dev)
        try:
            self.fd = os.open(path, os.O_RDWR)
        except PermissionError:
            self.last_error = "permission"
            raise DeviceError(
                "Permission denied on %s\n"
                "Install the udev rule first:\n"
                "  sudo ./install.sh\n"
                "  (or: sudo cp 99-t1-keyboard.rules /etc/udev/rules.d/ "
                "&& sudo udevadm control --reload-rules && sudo udevadm trigger "
                "&& unplug/replug the keyboard)" % path)
        except OSError as exc:
            self.last_error = str(exc)
            return None
        self.node = path
        try:
            fcntl.ioctl(self.fd, USBDEVFS_CLAIMINTERFACE, ctypes.c_uint(CONFIG_INTERFACE))
        except OSError as exc:
            self.close()
            if exc.errno == errno.EBUSY:
                self.last_error = ("claim-failed: device busy - another "
                                   "t1-keyboard-config window/monitor is using it")
            else:
                self.last_error = "claim-failed: %s" % exc
            return None
        try:
            rid, data_len, had_id = self.read_report_descriptor()
        except Exception:
            rid, data_len, had_id = None, None, None
        return rid, data_len, had_id

    def control_in(self, request_type, request, wvalue, windex, length, timeout=1000):
        buf = ctypes.create_string_buffer(length)
        ctrl = _Ctrl(request_type, request, wvalue, windex, length, timeout,
                     ctypes.cast(buf, ctypes.c_void_p))
        n = fcntl.ioctl(self.fd, USBDEVFS_CONTROL, ctrl)
        if n < 0:
            raise OSError("control transfer failed")
        return buf.raw[:n]

    def hid_descriptor_lengths(self):
        """{interface: wDescriptorLength} from the configuration descriptor.

        The length must come from the HID descriptor: asking for a larger
        wLength makes the T1 firmware stall the endpoint and the xHCI
        controller eventually reports "HC died" (observed with wLength=1024).
        """
        try:
            head = self.control_in(0x81, 0x06, 0x0200, 0, 9, timeout=500)
            if len(head) < 4:
                return {}
            total = int.from_bytes(head[2:4], "little")
            if total < 9:
                return {}
            total = min(total, 1024)
            data = head if total == 9 else self.control_in(
                0x81, 0x06, 0x0200, 0, total, timeout=500)
        except OSError:
            return {}
        return hid_descriptor_lengths(data)

    def read_report_descriptor(self):
        lengths = self.hid_descriptor_lengths()
        length = lengths.get(CONFIG_INTERFACE)
        if not length and lengths:
            length = next(iter(lengths.values()))
        if not length:
            return None, None, None
        try:
            data = self.control_in(0x81, 0x06, 0x2200, CONFIG_INTERFACE, length,
                                   timeout=500)
        except OSError:
            return None, None, None
        parsed = parse_report_descriptor(data)
        if not parsed:
            return None, None, None
        outputs = parsed["outputs"]
        if not outputs:
            return None, None, None
        if len(outputs) == 1:
            rid, bits = next(iter(outputs.items()))
        else:
            non_zero = [r for r in outputs if r != 0]
            rid = non_zero[0] if non_zero else 0
            bits = outputs[rid]
        data_bytes = max(1, (bits + 7) // 8)
        return rid, data_bytes, rid != 0

    def send_frame(self, frame, report_id=0, has_report_id=True):
        for urb_type in self._urb_order():
            if self._send_urb(frame, urb_type):
                self._urb_type = urb_type
                return True
        return self._send_control(frame, report_id, has_report_id)

    def _urb_order(self):
        if self._urb_type in URB_TYPE_ORDER:
            return (self._urb_type,)
        return URB_TYPE_ORDER

    def _send_urb(self, frame, urb_type):
        keepalive = (ctypes.c_ubyte * len(frame)).from_buffer_copy(frame)
        urb = _Urb()
        urb.type = urb_type
        urb.endpoint = CONFIG_ENDPOINT
        urb.buffer = ctypes.addressof(keepalive)
        urb.buffer_length = len(frame)
        try:
            fcntl.ioctl(self.fd, USBDEVFS_SUBMITURB, urb)
        except OSError:
            return False
        deadline = time.time() + 2.0
        slot = ctypes.c_void_p(0)
        while time.time() < deadline:
            try:
                fcntl.ioctl(self.fd, USBDEVFS_REAPURBNDELAY, slot)
                return urb.status == 0
            except BlockingIOError:
                time.sleep(0.01)
            except OSError:
                break
        try:
            fcntl.ioctl(self.fd, USBDEVFS_DISCARDURB, 0)
        except OSError:
            pass
        return False

    def _send_control(self, frame, report_id=0, has_report_id=True):
        try:
            wvalue = (0x02 << 8) | (report_id if has_report_id else 0)
            buf = ctypes.create_string_buffer(bytes(frame), len(frame))
            ctrl = _Ctrl(0x21, 0x09, wvalue, CONFIG_INTERFACE, len(frame), 1000,
                         ctypes.cast(buf, ctypes.c_void_p))
            return fcntl.ioctl(self.fd, USBDEVFS_CONTROL, ctrl) >= 0
        except OSError:
            return False
# --- Windows: HID output report -------------------------------------------

IOCTL_HID_GET_REPORT_DESCRIPTOR = 0x000B040F
DIGCF_PRESENT = 0x00000002
DIGCF_DEVICEINTERFACE = 0x00000010
INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
GENERIC_READ = 0x80000000
GENERIC_WRITE = 0x40000000
FILE_SHARE_READ = 0x00000001
FILE_SHARE_WRITE = 0x00000002
OPEN_EXISTING = 3
ERROR_ACCESS_DENIED = 5

_WIN_DLLS = {}


def _win():
    """Load kernel32/setupapi/hid and declare prototypes (Windows only)."""
    if _WIN_DLLS:
        return _WIN_DLLS
    import ctypes.wintypes as wt

    class GUID(ctypes.Structure):
        _fields_ = [
            ("Data1", ctypes.c_uint32),
            ("Data2", ctypes.c_uint16),
            ("Data3", ctypes.c_uint16),
            ("Data4", ctypes.c_ubyte * 8),
        ]

    class SP_DEVICE_INTERFACE_DATA(ctypes.Structure):
        _fields_ = [
            ("cbSize", ctypes.c_uint32),
            ("InterfaceClassGuid", GUID),
            ("Flags", ctypes.c_uint32),
            ("Reserved", ctypes.c_uint32),
        ]

    class SP_DEVICE_INTERFACE_DETAIL_DATA_W(ctypes.Structure):
        _fields_ = [
            ("cbSize", ctypes.c_uint32),
            ("DevicePath", ctypes.c_wchar * 1),
        ]

    class HIDP_CAPS(ctypes.Structure):
        _fields_ = [
            ("Usage", ctypes.c_uint16),
            ("UsagePage", ctypes.c_uint16),
            ("InputReportByteLength", ctypes.c_uint16),
            ("OutputReportByteLength", ctypes.c_uint16),
            ("FeatureReportByteLength", ctypes.c_uint16),
            ("Reserved", ctypes.c_uint16 * 17),
            ("NumberLinkCollectionNodes", ctypes.c_uint16),
            ("NumberInputButtonCaps", ctypes.c_uint16),
            ("NumberInputValueCaps", ctypes.c_uint16),
            ("NumberInputDataIndices", ctypes.c_uint16),
            ("NumberOutputButtonCaps", ctypes.c_uint16),
            ("NumberOutputValueCaps", ctypes.c_uint16),
            ("NumberOutputDataIndices", ctypes.c_uint16),
            ("NumberFeatureButtonCaps", ctypes.c_uint16),
            ("NumberFeatureValueCaps", ctypes.c_uint16),
            ("NumberFeatureDataIndices", ctypes.c_uint16),
        ]

    k32 = ctypes.WinDLL("kernel32", use_last_error=True)
    setupapi = ctypes.WinDLL("setupapi", use_last_error=True)
    hid = ctypes.WinDLL("hid.dll", use_last_error=True)

    k32.CreateFileW.restype = wt.HANDLE
    k32.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, wt.LPVOID,
                                wt.DWORD, wt.DWORD, wt.HANDLE]
    k32.WriteFile.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.DWORD,
                              ctypes.POINTER(wt.DWORD), wt.LPVOID]
    k32.CloseHandle.argtypes = [wt.HANDLE]
    k32.DeviceIoControl.argtypes = [wt.HANDLE, wt.DWORD, ctypes.c_void_p,
                                    wt.DWORD, ctypes.c_void_p, wt.DWORD,
                                    ctypes.POINTER(wt.DWORD), wt.LPVOID]

    setupapi.HidD_GetHidGuid.argtypes = [ctypes.c_void_p]
    setupapi.SetupDiGetClassDevsW.restype = ctypes.c_void_p
    setupapi.SetupDiGetClassDevsW.argtypes = [ctypes.c_void_p, wt.LPCWSTR,
                                              wt.LPCWSTR, wt.DWORD]
    setupapi.SetupDiEnumDeviceInterfaces.argtypes = [
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, wt.DWORD,
        ctypes.POINTER(SP_DEVICE_INTERFACE_DATA)]
    setupapi.SetupDiGetDeviceInterfaceDetailW.argtypes = [
        ctypes.c_void_p, ctypes.POINTER(SP_DEVICE_INTERFACE_DATA),
        ctypes.c_void_p, wt.DWORD, ctypes.POINTER(wt.DWORD), ctypes.c_void_p]
    setupapi.SetupDiDestroyDeviceInfoList.argtypes = [ctypes.c_void_p]

    hid.HidD_GetPreparsedData.argtypes = [wt.HANDLE, ctypes.POINTER(ctypes.c_void_p)]
    hid.HidD_FreePreparsedData.argtypes = [ctypes.c_void_p]
    hid.HidP_GetCaps.argtypes = [ctypes.c_void_p, ctypes.POINTER(HIDP_CAPS)]

    _WIN_DLLS.update({
        "k32": k32, "setupapi": setupapi, "hid": hid, "wt": wt,
        "GUID": GUID, "SP_DEVICE_INTERFACE_DATA": SP_DEVICE_INTERFACE_DATA,
        "SP_DEVICE_INTERFACE_DETAIL_DATA_W": SP_DEVICE_INTERFACE_DETAIL_DATA_W,
        "HIDP_CAPS": HIDP_CAPS,
    })
    return _WIN_DLLS


def win_find_device_path():
    """Path of the mi_01 (config) interface of the T1, or None."""
    libs = _win()
    wt, GUID = libs["wt"], libs["GUID"]
    setupapi = libs["setupapi"]
    guid = GUID()
    setupapi.HidD_GetHidGuid(ctypes.byref(guid))
    hdev = setupapi.SetupDiGetClassDevsW(
        ctypes.byref(guid), None, None, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE)
    if hdev in (None, INVALID_HANDLE_VALUE, 0):
        return None
    iface = libs["SP_DEVICE_INTERFACE_DATA"]()
    iface.cbSize = ctypes.sizeof(iface)
    detail_type = libs["SP_DEVICE_INTERFACE_DETAIL_DATA_W"]
    path = None
    try:
        for index in range(64):
            if not setupapi.SetupDiEnumDeviceInterfaces(
                    hdev, None, ctypes.byref(guid), index, ctypes.byref(iface)):
                break
            required = wt.DWORD(0)
            setupapi.SetupDiGetDeviceInterfaceDetailW(
                hdev, ctypes.byref(iface), None, 0, ctypes.byref(required), None)
            if not required.value:
                continue
            buf = ctypes.create_string_buffer(required.value)
            ctypes.cast(buf, ctypes.POINTER(detail_type)).contents.cbSize = (
                ctypes.sizeof(detail_type))
            if not setupapi.SetupDiGetDeviceInterfaceDetailW(
                    hdev, ctypes.byref(iface), buf, required.value,
                    ctypes.byref(required), None):
                continue
            text = ctypes.wstring_at(ctypes.addressof(buf) + 4)
            low = text.lower()
            if "vid_1189" in low and "pid_8890" in low and "mi_01" in low:
                path = text
                break
    finally:
        setupapi.SetupDiDestroyDeviceInfoList(hdev)
    return path


class WindowsHidTransport(BaseTransport):
    """HID output report writer for the T1 config interface (Windows)."""

    kind = "hid"

    def __init__(self):
        self._handle = None
        self._out_len = 65
        self.last_error = None
        self.node = None

    def is_open(self):
        return self._handle is not None

    def close(self):
        if self._handle is not None:
            try:
                _win()["k32"].CloseHandle(self._handle)
            except Exception:
                pass
        self._handle = None
        self.node = None

    def open(self):
        self.close()
        try:
            path = win_find_device_path()
        except Exception as exc:
            self.last_error = "enum-failed: %s" % exc
            return None
        if not path:
            self.last_error = "device-not-found"
            return None
        libs = _win()
        wt, k32 = libs["wt"], libs["k32"]
        handle = k32.CreateFileW(
            path, GENERIC_READ | GENERIC_WRITE,
            FILE_SHARE_READ | FILE_SHARE_WRITE, None, OPEN_EXISTING, 0, None)
        if handle in (None, INVALID_HANDLE_VALUE, 0):
            error = ctypes.get_last_error()
            if error == ERROR_ACCESS_DENIED:
                self.last_error = "permission: close other programs using the T1"
            else:
                self.last_error = "open-failed: error %d" % error
            return None
        self._handle = handle
        self.node = path
        self._out_len = self._output_report_length() or 65
        rid, data_len, had_id = self._read_report_descriptor()
        if rid is None:
            return None, None, None
        return rid, data_len, had_id

    def _output_report_length(self):
        libs = _win()
        preparsed = ctypes.c_void_p()
        caps = libs["HIDP_CAPS"]()
        hid = libs["hid"]
        if not hid.HidD_GetPreparsedData(self._handle, ctypes.byref(preparsed)):
            return 0
        try:
            if not hid.HidP_GetCaps(preparsed, ctypes.byref(caps)):
                return 0
            return int(caps.OutputReportByteLength)
        finally:
            hid.HidD_FreePreparsedData(preparsed)

    def _read_report_descriptor(self):
        """Report id / output length from IOCTL_HID_GET_REPORT_DESCRIPTOR."""
        try:
            libs = _win()
            buf = ctypes.create_string_buffer(2048)
            returned = libs["wt"].DWORD(0)
            if not libs["k32"].DeviceIoControl(
                    self._handle, IOCTL_HID_GET_REPORT_DESCRIPTOR, None, 0,
                    buf, len(buf), ctypes.byref(returned), None):
                return None, None, None
            parsed = parse_report_descriptor(buf.raw[:returned.value])
            if not parsed:
                return None, None, None
            outputs = parsed["outputs"]
            if len(outputs) == 1:
                rid, bits = next(iter(outputs.items()))
            else:
                non_zero = [r for r in outputs if r != 0]
                rid = non_zero[0] if non_zero else 0
                bits = outputs[rid]
            return rid, max(1, (bits + 7) // 8), rid != 0
        except Exception:
            return None, None, None

    def send_frame(self, frame, report_id=0, has_report_id=True):
        if self._handle is None:
            return False
        data = bytearray(frame)
        if has_report_id and not data:
            return False
        if len(data) < self._out_len:
            data.extend(b"\x00" * (self._out_len - len(data)))
        elif len(data) > self._out_len:
            data = data[:self._out_len]
        buf = (ctypes.c_ubyte * len(data)).from_buffer_copy(bytes(data))
        written = _win()["wt"].DWORD(0)
        try:
            ok = _win()["k32"].WriteFile(self._handle, buf, len(data),
                                         ctypes.byref(written), None)
        except Exception:
            return False
        return bool(ok)


