    class LearnThread(threading.Thread):
        def __init__(self, seconds, want_key=True, want_rel=False, ignore=()):
            super().__init__(daemon=True)
            self.seconds = seconds
            self.want_key = want_key
            self.want_rel = want_rel
            self.ignore = set(ignore)
            self.result = None
            self.done = False

        def run(self):
            fds = open_input_nodes()
            if not fds:
                self.done = True
                return
            deadline = time.time() + self.seconds
            while time.time() < deadline:
                try:
                    ready, _, _ = select.select([fd for fd, _ in fds], [], [],
                                                max(0.0, deadline - time.time()))
                except (OSError, ValueError):
                    break
                for fd in ready:
                    for etype, code, value in read_events(fd):
                        if value != 1:
                            continue
                        if etype == EV_KEY and self.want_key and code not in self.ignore:
                            self.result = ("key", code)
                            self.done = True
                            return
                        if etype == EV_REL and self.want_rel:
                            self.result = ("rel", code)
                            self.done = True
                            return
            self.done = True

