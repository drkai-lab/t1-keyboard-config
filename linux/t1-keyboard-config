EV_SYN, EV_KEY, EV_REL = 0x1, 0x2, 0x3
INPUT_EVENT = struct.Struct("llHHi")

DIAL_DEFAULT_CODES = (6, 7, 8, 11, 12)  # REL_HWHEEL / REL_DIAL / REL_WHEEL (+hi-res)


def t1_input_nodes():
    nodes = []
    for uevent in glob.glob("/sys/class/input/event*/device/uevent"):
        try:
            text = open(uevent).read()
        except OSError:
            continue
        product = ""
        for line in text.splitlines():
            if line.startswith("PRODUCT="):
                product = line.split("=", 1)[1].strip()
                break
        parts = product.split("/")
        if len(parts) < 3:
            continue
        try:
            if int(parts[1], 16) != VID or int(parts[2], 16) != PID:
                continue
        except ValueError:
            continue
        event = "/dev/input/" + os.path.basename(
            os.path.dirname(os.path.dirname(uevent)))
        name = ""
        for line in text.splitlines():
            if line.startswith("NAME="):
                name = line.split("=", 1)[1].strip().strip('"')
        nodes.append((event, name))
    nodes.sort()
    return nodes


def open_input_nodes(nonblock=True):
    fds = []
    for path, _name in t1_input_nodes():
        try:
            flags = os.O_RDONLY | os.O_NONBLOCK
            fds.append((os.open(path, flags), path))
        except OSError:
            continue
    return fds


def read_events(fd):
    out = []
    while True:
        try:
            raw = os.read(fd, INPUT_EVENT.size)
        except BlockingIOError:
            break
        except OSError:
            break
        if len(raw) < INPUT_EVENT.size:
            break
        _sec, _usec, etype, code, value = INPUT_EVENT.unpack(raw)
        out.append((etype, code, value))
    return out


def which_wpctl():
    return shutil.which("wpctl")


def wpctl_volume(target, delta=None, absolute=None):
    if not which_wpctl():
        return False
    try:
        if delta is not None:
            result = subprocess.run(["wpctl", "get-volume", target],
                                    capture_output=True, text=True, timeout=2)
            current = float(result.stdout.split(":", 1)[1].strip().split()[0])
            value = max(0.0, min(2.0, current + delta))
            subprocess.run(["wpctl", "set-volume", target, "%.2f" % value],
                           capture_output=True, timeout=2)
        elif absolute is not None:
            subprocess.run(["wpctl", "set-volume", target, "%.2f" % max(0.0, min(2.0, absolute))],
                           capture_output=True, timeout=2)
        return True
    except Exception:
        return False


class OscSender:
    def __init__(self, host="127.0.0.1", port=9000):
        self.host = host
        self.port = int(port)

    @staticmethod
    def _pad(raw):
        return raw + b"\x00" * ((4 - len(raw) % 4) % 4)

    def send_bool(self, address, value):
        import socket
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.sendto(self._pad(address.encode()) +
                        self._pad(b",T" if value else b",F") +
                        (b"\x01" if value else b"\x00"),
                        (self.host, self.port))
            sock.close()
            return True
        except OSError:
            return False

    def send_float(self, address, value):
        import socket
        import struct as _st
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.sendto(self._pad(address.encode()) + self._pad(b",f") +
                        _st.pack(">f", float(value)), (self.host, self.port))
            sock.close()
            return True
        except OSError:
            return False


