def which_wpctl():
    return shutil.which("wpctl")


def wpctl_volume(target, delta=None, absolute=None):
    if not which_wpctl():
        return False
    try:
        if delta is not None:
            result = subprocess.run(["wpctl", "get-volume", target],
                                    capture_output=True, text=True, timeout=2)
            current = float(result.stdout.split(":", 1)[1].strip().split()[0])
            value = max(0.0, min(2.0, current + delta))
            subprocess.run(["wpctl", "set-volume", target, "%.2f" % value],
                           capture_output=True, timeout=2)
        elif absolute is not None:
            subprocess.run(["wpctl", "set-volume", target, "%.2f" % max(0.0, min(2.0, absolute))],
                           capture_output=True, timeout=2)
        return True
    except Exception:
        return False


def _windows_volume(kind, delta=None, absolute=None):
    """Core Audio (IAudioEndpointVolume) with a media-key fallback."""
    try:
        return _windows_core_volume(kind, delta, absolute)
    except Exception:
        pass
    try:
        if delta:
            import ctypes.wintypes as wt
            user32 = ctypes.WinDLL("user32", use_last_error=True)
            key = 0xAF if delta > 0 else 0xAE
            user32.keybd_event(key, 0, 0, 0)
            user32.keybd_event(key, 0, 2, 0)  # KEYEVENTF_KEYUP
            return True
    except Exception:
        pass
    return False


def _windows_core_volume(kind, delta=None, absolute=None):
    import ctypes.wintypes as wt

    ole32 = ctypes.WinDLL("ole32", use_last_error=True)
    ole32.CoInitializeEx(None, 0)
    class GUID(ctypes.Structure):
        _fields_ = [("Data1", ctypes.c_uint32), ("Data2", ctypes.c_uint16),
                    ("Data3", ctypes.c_uint16), ("Data4", ctypes.c_ubyte * 8)]

    def make_guid(text):
        parts = text.replace("-", "").split()
        value = GUID()
        value.Data1 = int(parts[0], 16)
        value.Data2 = int(parts[1], 16)
        value.Data3 = int(parts[2], 16)
        value.Data4 = (ctypes.c_ubyte * 8)(
            *[int(parts[3][i:i + 2], 16) for i in range(0, 16, 2)])
        return value

    ole32.CoCreateInstance.argtypes = [
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong, ctypes.c_void_p,
        ctypes.c_void_p]
    enumerator = ctypes.c_void_p()
    hr = ole32.CoCreateInstance(
        ctypes.byref(make_guid("BCDE0395-E52F-467C-8E3D-C4579291692E")),
        None, 23,
        ctypes.byref(make_guid("A95664D2-9614-4F35-A746-DE8DB63617E6")),
        ctypes.byref(enumerator))
    if hr or not enumerator.value:
        return False
    device = ctypes.c_void_p()
    vtable = ctypes.POINTER(ctypes.c_void_p).from_address(enumerator.value)
    get_default = ctypes.CFUNCTYPE(
        ctypes.c_long, ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
        ctypes.c_void_p)(vtable[5])
    hr = get_default(enumerator, 1 if kind == "source" else 0, 1,
                     ctypes.byref(device))
    if hr or not device.value:
        return False
    volume = ctypes.c_void_p()
    dtable = ctypes.POINTER(ctypes.c_void_p).from_address(device.value)
    activate = ctypes.CFUNCTYPE(
        ctypes.c_long, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong,
        ctypes.c_void_p, ctypes.c_void_p)(dtable[3])
    empty = (ctypes.c_ubyte * 16)()
    hr = activate(device, ctypes.byref(make_guid("5CDF2C82-841E-454D-97D2-52926851F1CC")),
                  1, empty, ctypes.byref(volume))
    if hr or not volume.value:
        return False
    vtable_v = ctypes.POINTER(ctypes.c_void_p).from_address(volume.value)
    if absolute is not None:
        setter = ctypes.CFUNCTYPE(ctypes.c_long, ctypes.c_void_p, ctypes.c_float,
                                  ctypes.c_void_p)(vtable_v[7])
        return setter(volume, ctypes.c_float(max(0.0, min(1.0, absolute))), None) == 0
    getter = ctypes.CFUNCTYPE(ctypes.c_long, ctypes.c_void_p, ctypes.POINTER(ctypes.c_float),
                              ctypes.c_void_p)(vtable_v[9])
    level = ctypes.c_float(0.0)
    if getter(volume, ctypes.byref(level), None) != 0:
        return False
    setter = ctypes.CFUNCTYPE(ctypes.c_long, ctypes.c_void_p, ctypes.c_float,
                              ctypes.c_void_p)(vtable_v[7])
    return setter(volume, ctypes.c_float(max(0.0, min(1.0, level.value + delta))), None) == 0


def _macos_volume(kind, delta=None, absolute=None):
    try:
        if absolute is not None:
            value = int(round(max(0.0, min(1.0, absolute)) * 100))
        elif delta is not None:
            key = "input volume" if kind == "source" else "output volume"
            current = subprocess.run(
                ["osascript", "-e", "get %s of (get volume settings)" % key],
                capture_output=True, text=True, timeout=3)
            value = int(round(float(current.stdout.strip() or 0) + delta * 100))
        else:
            return False
        value = max(0, min(100, value))
        target = "input volume" if kind == "source" else "output volume"
        subprocess.run(["osascript", "-e", "set volume %s %d" % (target, value)],
                       capture_output=True, timeout=3)
        return True
    except Exception:
        return False


def set_volume(kind, delta=None, absolute=None):
    """Adjust the default sink ("sink") or source ("source"). Returns bool."""
    if IS_WIN:
        return _windows_volume(kind, delta, absolute)
    if IS_MAC:
        return _macos_volume(kind, delta, absolute)
    target = "@DEFAULT_AUDIO_SINK@" if kind == "sink" else "@DEFAULT_AUDIO_SOURCE@"
    return wpctl_volume(target, delta=delta, absolute=absolute)


class OscSender:
    def __init__(self, host="127.0.0.1", port=9000):
        self.host = host
        self.port = int(port)

    @staticmethod
    def _pad(raw):
        return raw + b"\x00" * ((4 - len(raw) % 4) % 4)

    def send_bool(self, address, value):
        import socket
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.sendto(self._pad(address.encode()) +
                        self._pad(b",T" if value else b",F") +
                        (b"\x01" if value else b"\x00"),
                        (self.host, self.port))
            sock.close()
            return True
        except OSError:
            return False

    def send_float(self, address, value):
        import socket
        import struct as _st
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.sendto(self._pad(address.encode()) + self._pad(b",f") +
                        _st.pack(">f", float(value)), (self.host, self.port))
            sock.close()
            return True
        except OSError:
            return False


