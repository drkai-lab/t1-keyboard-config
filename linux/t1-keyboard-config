    except Exception as exc:
        print("Tkinter is required for the GUI: %s" % exc, file=sys.stderr)
        print("Install it first (Arch: sudo pacman -S tk / "
              "Debian: sudo apt install python3-tk / macOS: brew install python-tk)",
              file=sys.stderr)
        return 1

    class LearnThread(threading.Thread):
        def __init__(self, seconds, want_key=True, want_rel=False, ignore=()):
            super().__init__(daemon=True)
            self.seconds = seconds
            self.want_key = want_key
            self.want_rel = want_rel
            self.ignore = set(ignore)
            self.result = None
            self.done = False
            self._stop = threading.Event()

        def _collect(self, source, deadline):
            for etype, code, value in source.wait(
                    max(0.05, min(0.5, deadline - time.time()))):
                if value != 1:
                    continue
                if etype == EV_KEY and self.want_key and code not in self.ignore:
                    self.result = ("key", code)
                    self.done = True
                    raise StopIteration
                if etype == EV_REL and self.want_rel:
                    self.result = ("rel", code)
                    self.done = True
                    raise StopIteration

        def run(self):
            source = open_input_source()
            if source is None:
                self.done = True
                return
            deadline = time.time() + self.seconds
            try:
                while time.time() < deadline:
                    try:
                        self._collect(source, deadline)
                    except StopIteration:
                        return
            finally:
                source.close()
                self.done = True

