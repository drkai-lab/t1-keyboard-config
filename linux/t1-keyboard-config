def log(message):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        with open(LOG_FILE, "a", encoding="utf-8") as fh:
            fh.write("%s %s\n" % (stamp, message))
    except OSError:
        pass


def pid_file_path():
    return os.path.join(STATE_DIR, "monitor.pid")


def write_pid_file():
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(pid_file_path(), "w", encoding="utf-8") as fh:
            fh.write(str(os.getpid()))
    except OSError:
        pass


def remove_pid_file():
    try:
        os.remove(pid_file_path())
    except OSError:
        pass


def _exit_on_signal(signum, _frame):
    raise SystemExit(128 + signum)


def run_monitor():
    log("monitor starting (pid %d)" % os.getpid())
    write_pid_file()
    previous = None
    try:
        previous = signal.signal(signal.SIGTERM, _exit_on_signal)
    except (ValueError, OSError, AttributeError):
        pass  # not the main thread / unsupported signal
    try:
        _monitor_loop()
    finally:
        if previous is not None:
            try:
                signal.signal(signal.SIGTERM, previous)
            except (ValueError, OSError, AttributeError):
                pass
        remove_pid_file()


def _monitor_loop():
    settings = load_settings()
    mtime = _settings_mtime()
    osc_cfg = settings.get("osc", {})
    osc = OscSender(osc_cfg.get("host", "127.0.0.1"), osc_cfg.get("port", 9000))

    source = None
    bindings = {}
    rotate_codes = set()
    push_code = None
    modes = ["mic", "headphone", "user"]
    mode_idx = 0
    user_vol = 0.5

    def reload_settings():
        nonlocal settings, osc, bindings, rotate_codes, push_code
        nonlocal modes, mode_idx, user_vol
        settings = load_settings()
        osc_cfg = settings.get("osc", {})
        osc = OscSender(osc_cfg.get("host", "127.0.0.1"), osc_cfg.get("port", 9000))
        bindings = {}
        for key, cfg in settings.get("key_osc", {}).items():
            if cfg.get("code") and cfg.get("addr"):
                bindings[int(cfg["code"])] = (cfg["addr"], bool(cfg.get("toggle")))
        dial = settings.get("dial", {})
        rotate_codes = set(dial.get("rotate_codes") or list(DIAL_DEFAULT_CODES))
        push_code = dial.get("push_code")
        modes = dial.get("modes") or ["mic", "headphone", "user"]
        mode_idx = int(dial.get("start_index", 0)) % max(1, len(modes))
        user_vol = float(settings.get("_user_vol", 0.5))

    reload_settings()
    warned_empty = False

    while True:
        if source is None:
            source = open_input_source()
            if source is None:
                if not warned_empty:
                    warned_empty = True
                    log("no readable input node yet (udev rule / permissions?)")
                time.sleep(2.0)
                continue
            warned_empty = False
            log("monitor attached to " + source.describe())
        if _settings_mtime() != mtime:
            mtime = _settings_mtime()
            reload_settings()

        try:
            events = source.wait(0.25)
        except (OSError, ValueError):
            source.close()
            source = None
            continue
        for etype, code, value in events:
            if etype == EV_KEY and value == 1:
                if push_code is not None and code == push_code:
                    mode_idx = (mode_idx + 1) % max(1, len(modes))
                    dial = settings.setdefault("dial", {})
                    dial["start_index"] = mode_idx
                    save_settings(settings)
                    log("dial mode -> %s" % modes[mode_idx])
                    continue
                if code in bindings:
                    address, toggle = bindings[code]
                    if toggle:
                        state = settings.setdefault("_osc_state", {})
                        new_state = not state.get(str(code), False)
                        state[str(code)] = new_state
                        save_settings(settings)
                        osc.send_bool(address, new_state)
                    else:
                        osc.send_bool(address, True)
            elif etype == EV_KEY and value == 0:
                if code in bindings and not bindings[code][1]:
                    osc.send_bool(bindings[code][0], False)
            elif etype == EV_REL and code in rotate_codes:
                if value == 0:
                    continue
                dial = settings.get("dial", {})
                step = float(dial.get("step", 0.05))
                direction = step if value > 0 else -step
                mode = modes[mode_idx] if modes else "mic"
                if mode == "mic":
                    set_volume("source", delta=direction)
                elif mode == "headphone":
                    set_volume("sink", delta=direction)
                else:
                    user_vol = max(0.0, min(1.0, user_vol + direction))
                    address = settings.get("osc", {}).get(
                        "user_volume_addr", "/avatar/parameters/UserVolume")
                    osc.send_float(address, user_vol)
                    settings["_user_vol"] = user_vol
                    save_settings(settings)


def _settings_mtime():
    try:
        return os.stat(CONFIG_FILE).st_mtime_ns
    except OSError:
        return 0


