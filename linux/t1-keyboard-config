def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def _read_pid_file():
    try:
        with open(pid_file_path(), encoding="utf-8") as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return None
    return pid if pid > 0 and _pid_alive(pid) else None


def monitor_is_running():
    if _read_pid_file():
        return True
    if os.path.exists(pid_file_path()):
        remove_pid_file()  # stale: the recorded pid is gone
    if not IS_LINUX:
        return False
    try:
        out = subprocess.run(["pgrep", "-f", "%s --monitor" % APP_NAME],
                             capture_output=True, text=True, timeout=3)
        return bool(out.stdout.strip())
    except Exception:
        return False


def start_monitor_process():
    if IS_LINUX and not which_wpctl():
        return False, "wpctl not found (install pipewire-utils)"
    try:
        script = os.path.abspath(globals().get("__file__", sys.argv[0]))
        command = [sys.executable, script, "--monitor"]
        if IS_WIN:
            subprocess.Popen(
                command,
                creationflags=0x00000008 | 0x00000200,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                close_fds=True)
        else:
            subprocess.Popen(command, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        return True, None
    except Exception as exc:
        return False, str(exc)


def stop_monitor_process():
    pid = _read_pid_file()
    if pid:
        try:
            if IS_WIN:
                subprocess.run(["taskkill", "/PID", str(pid), "/T", "/F"],
                               capture_output=True, timeout=5)
            else:
                os.kill(pid, signal.SIGTERM)
            remove_pid_file()
            return True
        except Exception:
            return False
    if not IS_LINUX:
        return False
    try:
        subprocess.run(["pkill", "-f", "%s --monitor" % APP_NAME],
                       capture_output=True, timeout=3)
        return True
    except Exception:
        return False


