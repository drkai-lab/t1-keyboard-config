def selftest(write=False, verbose=True):
    results = []

    def check(name, ok, detail=""):
        results.append((name, ok, detail))
        if verbose:
            print("%-28s %s%s" % (name, "OK  " if ok else "FAIL",
                                  (" - " + detail) if detail else ""))

    rule_ok = os.path.exists(UDEV_RULE)
    check("udev rule installed", rule_ok, UDEV_RULE if rule_ok else
          "run: sudo ./install.sh")

    node = usb_node_path()
    check("usb device present", node is not None, node or "1189:8890 not found")

    device = T1Device()
    if node:
        try:
            opened = os.open(node, os.O_RDWR)
            os.close(opened)
            check("usb node permission", True, node)
        except OSError as exc:
            check("usb node permission", False, str(exc))

    connected = False
    if node:
        try:
            connected = device.connect()
            detail = ""
            if not connected:
                detail = device.last_error or ""
            check("config interface (usbfs)", connected, detail)
        except DeviceError as exc:
            check("config interface (usbfs)", False, str(exc).splitlines()[0])

    if connected:
        check("report id detected", True,
              "id=%d data=%d bytes frame=%d" % (
                  device.report_id, device.data_len,
                  1 + device.data_len if device.had_report_id else device.data_len))
        check("write path", True, "urb_type=%s" %
              ("interrupt" if device._urb_type == USBDEVFS_URB_TYPE_INTERRUPT else
               "bulk" if device._urb_type == USBDEVFS_URB_TYPE_BULK else "control"))
        if write:
            ok = device.switch_layer(1) and device.write_payload(flash_report())
            check("test write (layer+flash)", ok, "" if ok else "failed")

    hidraw = sorted(glob.glob("/dev/hidraw*"))
    readable = []
    for path in hidraw:
        try:
            handle = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            os.close(handle)
            readable.append(os.path.basename(path))
        except OSError:
            pass
    check("hidraw readable", bool(hidraw) and len(readable) == len(hidraw),
          "%d/%d" % (len(readable), len(hidraw)))

    nodes = t1_input_nodes()
    ev_readable = []
    for path, _name in nodes:
        try:
            handle = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            os.close(handle)
            ev_readable.append(os.path.basename(path))
        except OSError:
            pass
    check("input events readable", bool(nodes) and len(ev_readable) == len(nodes),
          "%d/%d of %s" % (len(ev_readable), len(nodes),
                           ",".join(os.path.basename(p) for p, _ in nodes)))

    device.close()
    passed = all(ok for _, ok, _ in results)
    if verbose:
        print("\nRESULT: %s" % ("PASS" if passed else "FAIL"))
    return 0 if passed else 1


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="T1 mini keyboard configuration tool for Linux")
    parser.add_argument("--version", action="version", version="%s %s" % (APP_NAME, VERSION))
    parser.add_argument("--monitor", action="store_true",
                        help="run the dial/OSC monitor daemon in the foreground")
    parser.add_argument("--selftest", action="store_true",
                        help="check device access and the write path")
    parser.add_argument("--write", action="store_true",
                        help="with --selftest: perform a harmless test write")
    parser.add_argument("--watch", nargs="?", const=0, type=int, default=None,
                        metavar="SECONDS",
                        help="print T1 input events (0 or omitted = until Ctrl-C)")
    parser.add_argument("--gui", action="store_true", help="start the GUI (default)")
    args = parser.parse_args(argv)

    if args.monitor:
        try:
            run_monitor()
        except KeyboardInterrupt:
            return 0
        return 0
    if args.watch is not None:
        return run_watch(args.watch or None)
    if args.selftest:
        return selftest(write=args.write)
    return run_gui()


if __name__ == "__main__":
    sys.exit(main())
