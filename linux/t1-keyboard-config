            learn_row = ttk.Frame(frame)
            learn_row.pack(fill="x", padx=8, pady=8)
            self.learn_rotate_btn = ttk.Button(
                learn_row, text=self.tr("learn_rotate"), command=self.on_learn_rotate)
            self.learn_rotate_btn.pack(side="left")
            self.learn_push_btn = ttk.Button(
                learn_row, text=self.tr("learn_push"), command=self.on_learn_push)
            self.learn_push_btn.pack(side="left", padx=6)

            self.dial_state = tk.Label(frame, anchor="w", text="")
            self.dial_state.pack(fill="x", padx=8)

            self.mon_btn = ttk.Button(frame, text=self.tr("start_monitor"),
                                      command=self.on_monitor_toggle)
            self.mon_btn.pack(fill="x", padx=8, pady=(10, 8))

        def _build_about_page(self):
            frame = ttk.Frame(self.notebook)
            self.about_text = tk.Text(frame, wrap="word", relief="flat",
                                      padx=10, pady=10)
            self.about_text.pack(fill="both", expand=True)
            self.about_text.configure(state="disabled")
            self._add_page(frame)

        # -- helpers -------------------------------------------------------
        def tr(self, key):
            return I18N[self.lang].get(key, I18N["en"].get(key, key))

        def status(self, message):
            self.toast.configure(text=message)

        def on_toggle_lang(self):
            self.lang = "en" if self.lang == "ja" else "ja"
            self.settings["lang"] = self.lang
            save_settings(self.settings)
            self.apply_lang()

        def apply_lang(self):
            self._updating = True
            try:
                t = I18N[self.lang]
                self.root.title(t["app"])
                self.lang_btn.configure(text="JA" if self.lang == "en" else "EN")
                self.key_label.configure(text=t["selected"])
                self.clear_btn.configure(text=t["clear"])
                self.dl_btn.configure(text=t["download"])
                self.disable_btn.configure(text=t["disable_key"])
                self.layer_label.configure(text=t["layer"])
                self.osc_hint.configure(text=t["osc_hint"])
                self.dial_hint.configure(text=t["dial_hint"])
                self.learn_rotate_btn.configure(text=t["learn_rotate"])
                self.learn_push_btn.configure(text=t["learn_push"])
                self.about_text.configure(state="normal")
                self.about_text.delete("1.0", "end")
                self.about_text.insert("1.0", t["help_text"] + "\n\n" + t["about_text"])
                self.about_text.configure(state="disabled")
                page_keys = ["page_key", "page_fun", "page_media", "page_mouse",
                             "page_led", "page_osc", "page_dial", "page_about"]
                for index, key in enumerate(page_keys):
                    self.notebook.tab(self.pages[index], text=t[key])
                self.refresh_assignment()
            finally:
                self._updating = False
            self.update_conn_ui(self._last_conn)
            self.update_monitor_button()

        def update_conn_ui(self, connected):
            self._last_conn = connected
            if connected:
                self.status_dot.configure(fg="green")
                text = self.tr("connected")
            else:
                self.status_dot.configure(fg="red")
                text = self.tr("disconnected")
            self.status_txt.configure(text=text)

        def tick_connect(self):
            if not self.dev.is_open():
                try:
                    ok = self.dev.connect()
                except DeviceError as exc:
                    ok = False
                    self._last_error = self.dev.last_error
                    if not self._tried_permission:
                        self._tried_permission = True
                        self.status(str(exc))
                except Exception as exc:
                    ok = False
                    if str(exc) != self._last_error:
                        self._last_error = str(exc)
                        self.status(str(exc))
                if ok:
                    self._last_error = None
                    if self.report_layer_needed():
                        self.dev.switch_layer(self.layer)
                elif self.dev.last_error and self.dev.last_error != self._last_error:
                    self._last_error = self.dev.last_error
                    self.status(self.dev.last_error)
                self.update_conn_ui(ok)
            else:
                self.update_conn_ui(True)
            self.update_monitor_button()
            self.root.after(1000, self.tick_connect)

        def report_layer_needed(self):
            return self.dev.report_id != 0

        def current_layer(self):
            return self.layer

        def on_layer_changed(self, _event=None):
            if self._updating:
                return
            try:
                selected = int(self.layer_var.get())
            except ValueError:
                return
            if selected == self.layer:
                return
            self.layer = selected
            self.settings["layer"] = selected
            save_settings(self.settings)
            if self.dev.is_open() and self.report_layer_needed():
                self.dev.switch_layer(selected)
            self.refresh_assignment()

        def refresh_assignment(self):
            layer_key = str(self.layer)
            store = self.settings.get("assignments", {}).get(layer_key, {})
            if self.selected_key is None:
                self.assign_label.configure(
                    text="%s: %s" % (self.tr("current"), self.tr("no_key")))
                return
            value = store.get(str(self.selected_key))
            name = dict(PHYS_KEYS).get(self.selected_key, str(self.selected_key))
            self.assign_label.configure(
                text="%s [%s]: %s" % (self.tr("current"), name,
                                      value or self.tr("assign_empty")))

        def remember(self, description):
            store = self.settings.setdefault("assignments", {}).setdefault(
                str(self.layer), {})
            if self.selected_key is not None:
                store[str(self.selected_key)] = description
            save_settings(self.settings)
            self.refresh_assignment()

        # -- key selection --------------------------------------------------
        def on_pick_key(self, num):
            self.selected_key = num
            for number, button in self.key_buttons.items():
                button.configure(
                    relief="sunken" if number == num else "raised",
                    bg="#ffcccc" if number == num
                    else getattr(self, "_key_bg", "lightgrey"))
            self.refresh_assignment()

        def on_clear(self):
            self.selected_key = None
            self.pending = None
            self.status("")
            for button in self.key_buttons.values():
                button.configure(relief="raised",
                                 bg=getattr(self, "_key_bg", "lightgrey"))
            self.refresh_assignment()

        def require_key(self):
            if self.selected_key is None:
                self.status(self.tr("pick_first"))
                return False
            if not self.dev.is_open():
                self.status(self.tr("need_device"))
                return False
            return True

        # -- page handlers --------------------------------------------------
        def on_add_group(self):
            mods = 0
            for mask, var in self.mod_checks.items():
                if var.get():
                    mods |= mask
            try:
                index = [n for n, _ in self.base_dd["values"]].index(
                    self.base_var.get())
            except ValueError:
                index = 0
            if index == 0:
                self.groups = []
            elif len(self.groups) < 5:
                self.groups.append((mods, USAGE_KEYS[index - 1][1]))
            self.render_groups()

        def on_reset_groups(self):
            self.groups = []
            for var in self.mod_checks.values():
                var.set(False)
            self.base_var.set("(modifier only) / 修飾のみ")
            self.render_groups()

        def render_groups(self):
            self.groups_list.delete(0, "end")
            if not self.groups:
                self.groups_list.insert("end", self.tr("assign_empty"))
                return
            for mods, usage in self.groups:
                self.groups_list.insert("end", self.describe(mods, usage))

        @staticmethod
        def describe(mods, usage):
            names = [name for name, mask in MODIFIERS if mods & mask]
            if usage:
                for label, code in USAGE_KEYS:
                    if code == usage:
                        names.append(label)
                        break
            return "+".join(names) or "-"

        def build_pending_from_groups(self):
            mods = 0
            for mask, var in self.mod_checks.items():
                if var.get():
                    mods |= mask
            try:
                index = [n for n, _ in self.base_dd["values"]].index(
                    self.base_var.get())
            except ValueError:
                index = 0
            if index == 0:
                keys = []
                lone = mods
                desc = self.describe(mods, 0)
            else:
                keys = list(self.groups)
                if not keys:
                    keys = [(mods, USAGE_KEYS[index - 1][1])]
                lone = keys[0][0]
                desc = " / ".join(self.describe(gmod, gusage)
                                  for gmod, gusage in keys)
            return {"kind": "key", "desc": desc, "keys": keys, "lone_mod": lone}

        def _selected(self, box):
            selection = box.curselection()
            return selection[0] if selection else None

        def on_download(self):
            page = self.notebook.index(self.notebook.select())
            if page == 0:
                index = self._selected(self.basic_list)
                if index is None:
                    self.status(self.tr("pick_function"))
                    return
                self.pending = {"kind": "key", "desc": USAGE_KEYS[index][0],
                                "keys": [(0, USAGE_KEYS[index][1])], "lone_mod": 0}
            elif page == 1:
                self.pending = self.build_pending_from_groups()
            elif page == 2:
                index = self._selected(self.media_list)
                if index is None:
                    self.status(self.tr("pick_function"))
                    return
                action, desc = MEDIA_ACTIONS[index]
                self.pending = {"kind": "media", "action": action, "desc": desc}
            elif page == 3:
                index = self._selected(self.mouse_list)
                if index is None:
                    self.status(self.tr("pick_function"))
                    return
                action, desc = MOUSE_ACTIONS[index]
                self.pending = {"kind": "mouse", "action": action, "desc": desc}
            elif page == 4:
                index = self._selected(self.led_list)
                if index is None:
                    self.status(self.tr("pick_function"))
                    return
                mode, desc = LED_MODES[index]
                self.pending = {"kind": "led", "mode": mode, "desc": desc}
            if self.pending is None:
                self.status(self.tr("pick_function"))
                return
            self.write_pending()

        def write_pending(self):
            pending = self.pending
            if pending is None:
                self.status(self.tr("pick_function"))
                return
            if pending["kind"] == "led":
                if not self.dev.is_open():
                    self.status(self.tr("need_device"))
                    return
                ok = self.dev.write_led(self.current_layer(), pending["mode"])
            else:
                if not self.require_key():
                    return
                layer = self.current_layer()
                if pending["kind"] == "key":
                    ok = self.dev.write_key(self.selected_key, layer,
                                            pending["keys"],
                                            pending.get("lone_mod", 0))
                elif pending["kind"] == "media":
                    ok = self.dev.write_media(self.selected_key, layer,
                                              pending["action"])
                else:
                    ok = self.dev.write_mouse(self.selected_key, layer,
                                              pending["action"])
            if ok:
                self.remember(pending["desc"])
                self.status("%s (%s)" % (self.tr("download_ok"), pending["desc"]))
            else:
                self.status(self.tr("download_ng"))

        def on_disable(self):
            if not self.require_key():
                return
            ok = self.dev.write_key(self.selected_key, self.current_layer(), [], 0)
            if ok:
                self.remember(self.tr("assign_empty"))
                self.status(self.tr("download_ok"))
            else:
                self.status(self.tr("download_ng"))

        def on_help(self):
            messagebox.showinfo(self.tr("help_title"), self.tr("help_text"),
                                parent=self.root)

        # -- OSC ------------------------------------------------------------
        def _save_osc_host(self):
            if self._updating:
                return
            self.settings.setdefault("osc", {})["host"] = self.osc_host.get().strip()
            save_settings(self.settings)

        def _save_osc_port(self):
            if self._updating:
                return
            try:
                self.settings.setdefault("osc", {})["port"] = int(
                    self.osc_port.get().strip())
                save_settings(self.settings)
            except ValueError:
                pass

        def _save_user_vol(self):
            if self._updating:
                return
            value = self.user_vol_entry.get().strip()
            self.settings.setdefault("osc", {})["user_volume_addr"] = value
            self.user_vol_label.configure(text=value)
            save_settings(self.settings)

        def _save_osc_toggle(self, num):
            if self._updating:
                return
            _address, toggle = self.osc_rows[num]
            cfg = self.settings.setdefault("key_osc", {}).setdefault(
                str(num), {"addr": "", "toggle": False, "code": None})
            cfg["toggle"] = bool(toggle.get())
            save_settings(self.settings)

        def _save_osc_addr(self, num):
            if self._updating:
                return
            address, _toggle = self.osc_rows[num]
            cfg = self.settings.setdefault("key_osc", {}).setdefault(
                str(num), {"addr": "", "toggle": False, "code": None})
            cfg["addr"] = address.get().strip()
            save_settings(self.settings)

        def on_dial_mode(self, mode_id):
            if self._updating:
                return
            dial = self.settings.setdefault("dial", {})
            current = set(dial.get("modes", ["mic", "headphone", "user"]))
            if self.dial_checks[mode_id].get():
                current.add(mode_id)
            else:
                current.discard(mode_id)
            dial["modes"] = [m["id"] for m in DIAL_MODES if m["id"] in current]
            save_settings(self.settings)

        # -- learning -------------------------------------------------------
        def start_learn(self, label, seconds, callback, want_key=True,
                        want_rel=False, ignore=()):
            if self._learn is not None and not self._learn.done:
                return
            self.status(label)
            thread = LearnThread(seconds, want_key=want_key, want_rel=want_rel,
                                 ignore=ignore)
            self._learn = thread
            thread.start()
            self._poll_learn(thread, callback)

        def _poll_learn(self, thread, callback):
            if not thread.done:
                self.root.after(200, lambda: self._poll_learn(thread, callback))
                return
            if thread.result:
                callback(thread.result[0], thread.result[1])
            else:
                self.status(self.tr("learn_fail"))
            self._learn = None

        def _ignore_codes(self):
            ignore = set()
            for code_cfg in self.settings.get("key_osc", {}).values():
                if code_cfg.get("code"):
                    ignore.add(int(code_cfg["code"]))
            push = self.settings.get("dial", {}).get("push_code")
            if push:
                ignore.add(int(push))
            return ignore

        def on_learn_key(self, num):
            def done(_kind, code):
                cfg = self.settings.setdefault("key_osc", {}).setdefault(
                    str(num), {"addr": "", "toggle": False, "code": None})
                cfg["code"] = code
                save_settings(self.settings)
                self.status("%s: %d" % (self.tr("learn_done"), code))

            self.start_learn(self.tr("learning"), 5, done,
                             ignore=self._ignore_codes())

        def on_learn_rotate(self):
            def done(_kind, code):
                self.settings.setdefault("dial", {})["rotate_codes"] = [code]
                save_settings(self.settings)
                self.refresh_dial_state()
                self.status("%s: %d" % (self.tr("learn_done"), code))

            self.start_learn(self.tr("learning"), 6, done,
                             want_key=False, want_rel=True)

        def on_learn_push(self):
            def done(_kind, code):
                self.settings.setdefault("dial", {})["push_code"] = code
                save_settings(self.settings)
                self.refresh_dial_state()
                self.status("%s: %d" % (self.tr("learn_done"), code))

            self.start_learn(self.tr("learning"), 6, done,
                             ignore=self._ignore_codes())

        def refresh_dial_state(self):
            dial = self.settings.get("dial", {})
            rotate = dial.get("rotate_codes") or list(DIAL_DEFAULT_CODES)
            push = dial.get("push_code")
            self.dial_state.configure(text="rotate=%s  push=%s" % (rotate, push))

        # -- monitor --------------------------------------------------------
        def update_monitor_button(self):
            running = monitor_is_running()
            self.mon_btn.configure(
                text=self.tr("stop_monitor") if running
                else self.tr("start_monitor"))
            if hasattr(self, "dial_state"):
                self.refresh_dial_state()

        def on_monitor_toggle(self):
            if monitor_is_running():
                stop_monitor_process()
                self.status(self.tr("monitor_stopped"))
            else:
                ok, err = start_monitor_process()
                self.status(self.tr("monitor_error") + (": " + err if err else "")
                            if not ok else self.tr("monitor_running"))
            self.update_monitor_button()

    root = tk.Tk()
    MainWindow(root)
    root.mainloop()
    return 0


# ---------------------------------------------------------------------------
# event watch (diagnostics)
# ---------------------------------------------------------------------------

INPUT_CODES = "/usr/include/linux/input-event-codes.h"


def load_input_names():
    """{(evtype, code): name}, preferring the kernel header when present."""
    names = {}
    try:
        lines = open(INPUT_CODES, encoding="utf-8", errors="replace")
    except OSError:
        lines = None
    if lines is not None:
        pattern = re.compile(r"^\s*#define\s+((?:KEY|BTN|REL|ABS)_[A-Z0-9_]+)\s+(\d+)")
        with lines:
            for line in lines:
                match = pattern.match(line)
                if match:
                    name = match.group(1)
                    etype = (EV_REL if name.startswith("REL_") else
                             3 if name.startswith("ABS_") else EV_KEY)
                    names.setdefault((etype, int(match.group(2))), name)
    for key, name in EVDEV_KEY_NAMES.items():
        names.setdefault(key, name)
    return names


def event_names(names, etype, code):
    label = names.get((etype, code))
    if label is None:
        label = "0x%03x" % code
    kind = {EV_KEY: "KEY", EV_REL: "REL", 3: "ABS", 4: "MSC"}.get(
        etype, "EV%d" % etype)
    return kind, label


def run_watch(seconds=None):
    source = open_input_source()
    if source is None:
        print("no readable T1 input node - check the udev rule / permissions",
              file=sys.stderr)
        return 1
    names = load_input_names()
    print("watching: %s" % source.describe())
    print("press a key or turn the dial (Ctrl-C to stop)")
    deadline = time.time() + seconds if seconds else None
    try:
        while deadline is None or time.time() < deadline:
            try:
                events = source.wait(0.5)
            except (OSError, ValueError):
                break
            for etype, code, value in events:
                if etype == EV_SYN:
                    continue
                kind, label = event_names(names, etype, code)
                if etype == EV_KEY:
                    state = "down" if value == 1 else ("up" if value == 0 else "repeat")
                else:
                    state = "%+d" % value
                print("  %-9s %-4s %-18s %s" % (
                    source.name, kind, label, state))
                sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    finally:
        source.close()
    return 0


