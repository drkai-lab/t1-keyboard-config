def type_byte(layer, rtype, report_id):
    if report_id == 0:
        return rtype & 0x0F
    return ((layer & 0x0F) << 4) | (rtype & 0x0F)


def key_reports(keynum, layer, report_id, keys, lone_mod=0):
    """Build the group reports for a key assignment.

    keys: [(modifier_mask, usage), ...] in firmware slot order.
    Group 0 is the modifier-only prologue, groups 1..n carry the usages.
    """
    keys = list(keys)[:5]
    count = len(keys)
    first_mod = keys[0][0] if keys else (lone_mod & 0xFF)
    tb = type_byte(layer, TYPE_KEY, report_id)
    out = []
    for idx in range(count + 1):
        mod, usage = (first_mod, 0) if idx == 0 else keys[idx - 1]
        out.append(bytes([keynum & 0xFF, tb, count, idx, mod & 0xFF, usage & 0xFF]))
    return out


MEDIA_RID = {
    3: {"play": (205, 0), "prev": (182, 0), "next": (181, 0),
        "mute": (226, 0), "vol_up": (233, 0), "vol_down": (234, 0)},
    0: {"play": (64, 0), "prev": (128, 0), "next": (0, 1),
        "mute": (4, 0), "vol_up": (2, 0), "vol_down": (1, 0)},
    2: {"play": (0, 4), "prev": (0, 11), "next": (0, 10),
        "mute": (0, 1), "vol_up": (64, 0), "vol_down": (128, 0)},
}

MOUSE_PAYLOAD = {
    "left":  (1, 0, 0, 0, 0),
    "right": (2, 0, 0, 0, 0),
    "centre": (4, 0, 0, 0, 0),
    "wheel_up": (0, 0, 0, 1, 0),
    "wheel_down": (0, 0, 0, 0xFF, 0),
    "ctrl_wheel_up": (0, 0, 1, 1, 0),
    "ctrl_wheel_down": (0, 0, 1, 0xFF, 0),
    "shift_wheel_up": (0, 0, 1, 2, 0),
    "shift_wheel_down": (0, 0, 1, 0xFF, 0),
    "alt_wheel_up": (0, 0, 1, 4, 0),
    "alt_wheel_down": (0, 0, 1, 0xFF, 0),
}


def media_report(keynum, layer, report_id, action):
    table = MEDIA_RID.get(report_id, MEDIA_RID[3])
    b5, b6 = table[action]
    return bytes([keynum & 0xFF, type_byte(layer, TYPE_MEDIA, report_id), b5, b6])


def mouse_report(keynum, layer, report_id, action):
    payload = MOUSE_PAYLOAD[action]
    return bytes([keynum & 0xFF, type_byte(layer, TYPE_MOUSE, report_id)]) + bytes(payload)


def led_report(layer, report_id, mode):
    return bytes([0xB0, type_byte(layer, TYPE_LED, report_id), mode & 0x03])


def layer_report(layer):
    return bytes([0xA1, max(1, min(3, int(layer)))])


def flash_report():
    return bytes([0xAA, 0xAA])


def flash_led_report():
    return bytes([0xAA, 0xA1])


def probe_report():
    return bytes([0x00, 0x00])


