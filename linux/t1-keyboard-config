EV_SYN, EV_KEY, EV_REL = 0x1, 0x2, 0x3
INPUT_EVENT = struct.Struct("llHHi")

DIAL_DEFAULT_CODES = (6, 7, 8, 11, 12)  # REL_HWHEEL / REL_DIAL / REL_WHEEL (+hi-res)


def t1_input_nodes():
    nodes = []
    for uevent in glob.glob("/sys/class/input/event*/device/uevent"):
        try:
            text = open(uevent).read()
        except OSError:
            continue
        product = ""
        for line in text.splitlines():
            if line.startswith("PRODUCT="):
                product = line.split("=", 1)[1].strip()
                break
        parts = product.split("/")
        if len(parts) < 3:
            continue
        try:
            if int(parts[1], 16) != VID or int(parts[2], 16) != PID:
                continue
        except ValueError:
            continue
        event = "/dev/input/" + os.path.basename(
            os.path.dirname(os.path.dirname(uevent)))
        name = ""
        for line in text.splitlines():
            if line.startswith("NAME="):
                name = line.split("=", 1)[1].strip().strip('"')
        nodes.append((event, name))
    nodes.sort()
    return nodes


def open_input_nodes(nonblock=True):
    fds = []
    for path, _name in t1_input_nodes():
        try:
            flags = os.O_RDONLY | os.O_NONBLOCK
            fds.append((os.open(path, flags), path))
        except OSError:
            continue
    return fds


def read_events(fd):
    out = []
    while True:
        try:
            raw = os.read(fd, INPUT_EVENT.size)
        except BlockingIOError:
            break
        except OSError:
            break
        if len(raw) < INPUT_EVENT.size:
            break
        _sec, _usec, etype, code, value = INPUT_EVENT.unpack(raw)
        out.append((etype, code, value))
    return out


