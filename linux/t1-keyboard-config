                self.status("%s: %d" % (self.tr("learn_done"), code))
            self.start_learn(self.tr("learning"), 6, done, want_key=False, want_rel=True)

        def on_learn_push(self, _btn):
            ignore = set()
            for code_cfg in self.settings.get("key_osc", {}).values():
