INPUT_CODES = "/usr/include/linux/input-event-codes.h"


def load_input_names():
    names = {}
    try:
        lines = open(INPUT_CODES, encoding="utf-8", errors="replace")
    except OSError:
        return names
    pattern = re.compile(r"^\s*#define\s+((?:KEY|BTN|REL|ABS)_[A-Z0-9_]+)\s+(\d+)")
    with lines:
        for line in lines:
            match = pattern.match(line)
            if match:
                names.setdefault(int(match.group(2)), match.group(1))
    return names


def event_names(names, etype, code):
    label = names.get(code)
    if label is None:
        label = "0x%03x" % code
    kind = {EV_KEY: "KEY", EV_REL: "REL", 3: "ABS", 4: "MSC"}.get(
        etype, "EV%d" % etype)
    return kind, label


def run_watch(seconds=None):
    nodes = t1_input_nodes()
    if not nodes:
        print("no readable T1 input node - check the udev rule", file=sys.stderr)
        return 1
    fds = open_input_nodes()
    if not fds:
        print("cannot open %s" % ", ".join(path for _, path in nodes), file=sys.stderr)
        return 1
    names = load_input_names()
    paths = dict(fds)
    print("watching: %s" % ", ".join(os.path.basename(path) for _, path in fds))
    print("press a key or turn the dial (Ctrl-C to stop)")
    deadline = time.time() + seconds if seconds else None
    try:
        while deadline is None or time.time() < deadline:
            try:
                ready, _, _ = select.select([fd for fd, _ in fds], [], [], 0.5)
            except (OSError, ValueError):
                break
            for fd in ready:
                for etype, code, value in read_events(fd):
                    if etype == EV_SYN:
                        continue
                    kind, label = event_names(names, etype, code)
                    if etype == EV_KEY:
                        state = "down" if value == 1 else ("up" if value == 0 else "repeat")
                    else:
                        state = "%+d" % value
                    print("  %-9s %-4s %-18s %s" % (
                        os.path.basename(paths[fd]), kind, label, state))
                    sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    for fd, _ in fds:
        try:
            os.close(fd)
        except OSError:
            pass
    return 0


