def _vk_to_evdev():
    table = {
        0x08: 14, 0x09: 15, 0x0D: 28, 0x10: 42, 0x11: 29, 0x12: 56,
        0x13: 119, 0x14: 58, 0x1B: 1, 0x20: 57, 0x2C: 99,
        0x21: 104, 0x22: 109, 0x23: 107, 0x24: 102,
        0x25: 105, 0x26: 103, 0x27: 106, 0x28: 108,
        0x2D: 110, 0x2E: 111,
        0x5B: 125, 0x5C: 126, 0x5D: 139,
        0x90: 69, 0x91: 70,
        0xA0: 42, 0xA1: 54, 0xA2: 29, 0xA3: 97, 0xA4: 56, 0xA5: 100,
        0xAD: 113, 0xAE: 115, 0xAF: 114,
        0xB0: 167, 0xB1: 166, 0xB2: 165, 0xB3: 164,
        0xBD: 12, 0xBB: 13, 0xDB: 26, 0xDC: 43, 0xDD: 27,
        0xBA: 39, 0xDE: 40, 0xC0: 41, 0xBC: 51, 0xBE: 52, 0xBF: 53,
    }
    for index, code in enumerate([30, 48, 46, 32, 18, 33, 34, 35, 23, 36,
                                  37, 38, 50, 49, 24, 25, 16, 19, 31, 20,
                                  22, 47, 17, 45, 21, 44]):
        table[0x41 + index] = code
    table[0x30] = 11
    for index in range(1, 10):
        table[0x30 + index] = 1 + index
    for index in range(12):
        table[0x70 + index] = 59 + index if index < 10 else (87, 88)[index - 10]
    for index, code in enumerate([71, 72, 73, 75, 76, 77, 79, 80, 81, 82]):
        table[0x60 + index] = code
    table.update({0x6A: 55, 0x6B: 78, 0x6D: 74, 0x6E: 83, 0x6F: 98})
    return table


def _hid_usage_to_evdev():
    table = {}
