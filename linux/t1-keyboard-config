#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""T1 MINI Keyboard configuration tool for Linux (Arch / Omarchy).

Native re-implementation of the Windows "MINI KeyBoard.exe" (HIDTester)
configuration utility. Protocol reverse-engineered from the decompiled
original: VID=0x1189 PID=0x8890, config interface mi_01 (interface 1,
interrupt-OUT endpoint 0x02, no kernel driver bound).

Device write path uses usbfs (SUBMITURB) with a control-transfer fallback.
Run "t1-keyboard-config --selftest" to validate the install.
"""

from __future__ import annotations

